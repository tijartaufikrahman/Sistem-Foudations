@inject SaasBringtimeSolution.Services.IFoundationService FoundationService
@{
    var currentFoundation = await FoundationService.GetCurrentFoundationAsync();
    var foundationId = FoundationService.GetConfiguredFoundationId();
    var foundationName = (ViewData["FoundationName"] as string) ?? currentFoundation?.Name ?? "Portal Mitra";
    var foundationSlug = (ViewData["Slug"] as string) ?? currentFoundation?.Slug ?? "";
    var brandHref = "/";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] as string ?? $"{foundationName} - Situs Web Resmi & Portal Donasi")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <script>
        window.CONFIGURED_FOUNDATION_ID = @foundationId;
        window.CONFIGURED_FOUNDATION_NAME = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(foundationName))";
        window.CONFIGURED_FOUNDATION_SLUG = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(foundationSlug))";
    </script>
    <style>
        @@media (min-width: 992px) {
            .navbar-public .nav-item.dropdown:hover .dropdown-menu {
                display: block;
                margin-top: 0;
            }
        }
        .navbar-public .dropdown-menu {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        .navbar-public .dropdown-item {
            font-size: 0.88rem;
            transition: all 0.15s ease;
        }
        .navbar-public .dropdown-item:hover {
            background-color: #f0fdfa;
            color: var(--brand-teal);
        }
    </style>
</head>
<body>
    <!-- Main Outer Container adhering to aturan_styling.txt -->
    <div class="container-fluid px-0 position-relative min-vh-100" style="overflow-x: clip;">
        <!-- Top Announcement Bar -->
    <div class="top-announcement-bar py-1 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span><i class="fas fa-shield-check text-teal me-1" style="color: #2dd4bf;"></i> Situs Resmi Terverifikasi SK Kemenkumham &mdash; Portal Donasi Kebaikan</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="fas fa-certificate text-teal me-1" style="color: #2dd4bf;"></i> Transparansi Donasi 100% Amanah</span>
                <a href="/Faq" class="small text-white-50"><i class="fas fa-circle-question me-1"></i> Bantuan & FAQ</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-public sticky-top bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@brandHref" id="yayasanNavBrand">
                <span class="d-inline-flex align-items-center justify-content-center text-white rounded-3 shadow-sm overflow-hidden" 
                      id="navFoundLogoBox" style="width: 40px; height: 40px; background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
                    <i class="fas fa-hand-holding-heart fs-5"></i>
                </span>
                <div class="d-flex flex-column">
                    <span class="fw-bold fs-5 text-dark" style="letter-spacing: -0.5px; line-height: 1.1;" id="navFoundName">
                        @foundationName
                    </span>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size: 9.5px; letter-spacing: 0.8px;">
                        Situs Resmi Terverifikasi
                    </span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none px-2 py-1 rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation" style="background: #f1f5f9;">
                <span class="navbar-toggler-icon" style="filter: invert(30%) sepia(20%) saturate(1000%) hue-rotate(130deg);"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 py-2 py-lg-0" id="mainPublicNavList">
                    <!-- Dynamic items loaded via $(document).ready() -->
                </ul>

                <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0" id="navAuthArea">
                    <div class="spinner-border spinner-border-sm text-teal" role="status"></div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Comprehensive Public Footer -->
    <footer class="bg-dark text-white pt-5 pb-4" style="background-color: #0b1322 !important; border-top: 3px solid var(--brand-teal);">
        <div class="container">
            <div class="row g-4 mb-5">
                <!-- Col 1: About Foundation -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="rounded-3 p-2 text-white" style="background: var(--brand-teal);">
                            <i class="fas fa-hand-holding-heart fs-5"></i>
                        </div>
                        <h4 class="fw-bold mb-0 text-white" id="footerFoundTitle">@foundationName</h4>
                    </div>
                    <p class="text-white-50 small mb-4" id="footerFoundBio" style="line-height: 1.7;">
                        @(currentFoundation?.Bio ?? "Situs resmi penghimpunan dan penyaluran program kebaikan umat secara amanah, transparan, dan berbadan hukum sah di Indonesia.")
                    </p>
                </div>

                <!-- Col 2: Program Kebaikan -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase" style="letter-spacing: 0.5px;">Program Kebaikan</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-white-50">
                        <li><a href="/Campaigns" class="text-white-50 hover-teal">Semua Program</a></li>
                        <li><a href="/Campaigns?cat=sosial" class="text-white-50 hover-teal">Santunan & Bantuan</a></li>
                        <li><a href="/Campaigns?cat=pendidikan" class="text-white-50 hover-teal">Pendidikan & Yatim</a></li>
                        <li><a href="/Faq" class="text-white-50 hover-teal">Tanya Jawab (FAQ)</a></li>
                    </ul>
                </div>

                <!-- Col 3: Akses Portal Resmi -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase" style="letter-spacing: 0.5px;">Akses Akun</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-white-50">
                        <li><a href="/" class="text-white-50 hover-teal"><i class="fas fa-house me-1 text-teal"></i> Beranda Yayasan</a></li>
                        <li><a href="/Auth/Login" class="text-white-50 hover-teal"><i class="fas fa-arrow-right-to-bracket me-1 text-teal"></i> Masuk Akun</a></li>
                        <li><a href="/Auth/Register" class="text-white-50 hover-teal"><i class="fas fa-user-plus me-1 text-teal"></i> Daftar Donatur Baru</a></li>
                        <li><a href="/Prayers" class="text-white-50 hover-teal"><i class="fas fa-hands-praying me-1 text-teal"></i> Untaian Doa</a></li>
                    </ul>
                </div>

                <!-- Col 4: Layanan & Metode Pembayaran -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase" style="letter-spacing: 0.5px;">Saluran Pembayaran</h6>
                    <p class="text-white-50 small mb-3">
                        Donasi terverifikasi otomatis 24 jam melalui QRIS nasional dan Virtual Account resmi perbankan:
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="footer-channel-badge"><i class="fas fa-qrcode text-teal"></i> QRIS</span>
                        <span class="footer-channel-badge"><i class="fas fa-building-columns text-primary"></i> Mandiri</span>
                        <span class="footer-channel-badge"><i class="fas fa-building-columns text-info"></i> BCA</span>
                        <span class="footer-channel-badge"><i class="fas fa-building-columns text-warning"></i> BNI</span>
                        <span class="footer-channel-badge"><i class="fas fa-building-columns text-success"></i> BSI</span>
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 text-white-50 small">
                <div>
                    &copy; 2026 <strong id="footerCopyName">@foundationName</strong>. Hak cipta dilindungi undang-undang.
                </div>
                <div class="d-flex gap-3">
                    <a href="/#rekening" class="text-white-50 text-decoration-none">Rekening Resmi</a>
                    <span>•</span>
                    <a href="/Campaigns" class="text-white-50 text-decoration-none">Program Donasi</a>
                    <span>•</span>
                    <a href="/Auth/Login" class="text-white-50 text-decoration-none">Masuk Akun</a>
                </div>
            </div>
        </div>
    </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api-config.js" asp-append-version="true"></script>
    <script>
        // Handler Logout Publik
        window.handlePublicLogout = function (e) {
            if (e) e.preventDefault();
            try { sessionStorage.clear(); } catch(err) {}
            if (window.AuthSession && AuthSession.clearAll) {
                AuthSession.clearAll();
            } else if (window.AuthSession && AuthSession.removeUser) {
                AuthSession.removeUser();
            }
            window.location.href = '/Auth/Logout';
        };

        $(function () {
            var currentFoundationId = window.CONFIGURED_FOUNDATION_ID || 0;
            var currentFoundationSlug = window.CONFIGURED_FOUNDATION_SLUG || '';
            var navCacheKey = 'public_navbar_found_' + currentFoundationId;

            function formatPublicUrl(url) {
                if (!url || url === '#') return '#';
                var u = url.trim();
                var lower = u.toLowerCase();

                if (lower.startsWith('http://') || lower.startsWith('https://') || lower.startsWith('//')) {
                    return u;
                }

                // Bersihkan prefix tenant / slug jika ada
                var prefixes = ['/{tenant}', '/{slug}'];
                if (currentFoundationSlug) {
                    prefixes.push('/' + currentFoundationSlug.toLowerCase());
                }
                for (var p = 0; p < prefixes.length; p++) {
                    var pref = prefixes[p];
                    if (lower === pref) {
                        return '/';
                    }
                    if (lower.startsWith(pref + '/')) {
                        lower = lower.substring(pref.length);
                        u = u.substring(pref.length);
                    }
                }

                // Map clean MVC routes
                if (lower === '/campaigns' || lower === '/program' || lower === '/program-donasi') {
                    return '/Campaigns';
                }
                if (lower === '/news' || lower === '/berita' || lower === '/kabar' || lower === '/artikel' || lower === '/newsposts') {
                    return '/News';
                }
                if (lower === '/tentangkami' || lower === '/tentang-kami' || lower === '/profile' || lower === '/profil') {
                    return '/Profile';
                }
                if (lower === '/prayers' || lower === '/doa' || lower === '/untaian-doa') {
                    return '/Prayers';
                }
                if (lower === '/faq' || lower === '/tanya-jawab' || lower === '/bantuan') {
                    return '/Faq';
                }
                if (lower === '/login' || lower === '/masuk') {
                    return '/Auth/Login';
                }
                if (lower === '/daftar' || lower === '/register') {
                    return '/Auth/Register';
                }
                if (lower === '' || lower === '/') {
                    return '/';
                }

                if (!u.startsWith('/')) {
                    u = '/' + u;
                }
                return u;
            }

            function isPathActive(url) {
                if (!url) return false;
                var resolved = formatPublicUrl(url).toLowerCase().split('?')[0].replace(/\/+$/, '');
                var cur = window.location.pathname.toLowerCase().split('?')[0].replace(/\/+$/, '');
                if (resolved === '' || resolved === '/') {
                    return cur === '' || cur === '/';
                }
                return cur === resolved || cur.indexOf(resolved + '/') === 0;
            }

            function safeEsc(str) {
                if (!str) return '';
                if (typeof window.escHtml === 'function') return window.escHtml(str);
                return $('<div>').text(str).html();
            }

            function renderDynamicPublicNavbar(items) {
                var $navList = $('#mainPublicNavList');
                if (!$navList.length) return;

                if (!items || items.length === 0) {
                    $navList.empty();
                    return;
                }

                var html = '';
                items.forEach(function (item) {
                    var childList = item.dropdownItems || item.items || [];
                    var isDrop = (item.isDropdown === true || item.isDropdown === 'true' || item.targetType === 'group') && childList.length > 0;

                    if (isDrop) {
                        var hasActiveChild = childList.some(function (sub) {
                            return isPathActive(sub.url);
                        });

                        html += `
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-semibold px-3 ${hasActiveChild ? 'active' : ''}" 
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   ${hasActiveChild ? 'style="color: var(--brand-teal); font-weight: 700;"' : ''}>
                                    ${safeEsc(item.title)}
                                </a>
                                <ul class="dropdown-menu border-0 shadow rounded-3 py-2 mt-1">
                                    ${childList.map(function (sub) {
                                        var subActive = isPathActive(sub.url);
                                        var subUrl = formatPublicUrl(sub.url);
                                        return `
                                            <li>
                                                <a class="dropdown-item py-2 fw-medium ${subActive ? 'active fw-semibold' : ''}" 
                                                   href="${safeEsc(subUrl)}" 
                                                   target="${safeEsc(sub.target || '_self')}"
                                                   ${subActive ? 'style="color: var(--brand-teal); background-color: #f0fdfa;"' : ''}>
                                                    ${safeEsc(sub.title)}
                                                </a>
                                            </li>
                                        `;
                                    }).join('')}
                                </ul>
                            </li>
                        `;
                    } else {
                        var itemUrl = formatPublicUrl(item.url);
                        var isActive = isPathActive(item.url);
                        html += `
                            <li class="nav-item">
                                <a class="nav-link fw-semibold px-3 ${isActive ? 'active' : ''}" 
                                   href="${safeEsc(itemUrl)}" 
                                   target="${safeEsc(item.target || '_self')}"
                                   ${isActive ? 'style="color: var(--brand-teal); font-weight: 700;"' : ''}>
                                    ${safeEsc(item.title)}
                                </a>
                            </li>
                        `;
                    }
                });

                $navList.html(html);

                $('.navbar-public .navbar-nav a.nav-link:not(.dropdown-toggle)').off('click.navcollapse').on('click.navcollapse', function () {
                    var $collapse = $('#navbarNav');
                    if ($collapse.hasClass('show')) {
                        var bsCollapse = bootstrap.Collapse.getInstance($collapse[0]);
                        if (bsCollapse) bsCollapse.hide();
                        else $collapse.removeClass('show');
                    }
                });
            }

            // 1. Render navbar dari cache
            try {
                var cachedNavStr = sessionStorage.getItem(navCacheKey);
                if (cachedNavStr) {
                    var cachedNav = JSON.parse(cachedNavStr);
                    if (Array.isArray(cachedNav) && cachedNav.length > 0) {
                        renderDynamicPublicNavbar(cachedNav);
                    }
                }
            } catch (e) {}

            // 2. Sync navbar realtime dari API (dengan cache-buster)
            var apiUrl = (window.API_BASE_URL || 'http://localhost:10007/api') + '/foundationnavbars/public/' + encodeURIComponent(currentFoundationId);
            $.ajax({
                url: apiUrl,
                data: { _ts: Date.now() },
                cache: false,
                method: 'GET',
                success: function (res) {
                    var navList = null;
                    if (Array.isArray(res)) {
                        navList = res;
                    } else if (res && Array.isArray(res.items)) {
                        navList = res.items;
                    } else if (res && Array.isArray(res.value)) {
                        navList = res.value;
                    }

                    if (navList !== null) {
                        try {
                            sessionStorage.setItem(navCacheKey, JSON.stringify(navList));
                        } catch (e) {}
                        renderDynamicPublicNavbar(navList);
                    }
                }
            });

            // 3. Render Area Autentikasi Pengguna di Navbar
            var $authArea = $('#navAuthArea');
            var currentUser = null;
            try {
                if (typeof AuthSession !== 'undefined' && AuthSession.getUser) {
                    currentUser = AuthSession.getUser();
                }
            } catch (err) {}

            if (currentUser) {
                var name = currentUser.name || currentUser.namaLengkap || currentUser.email || 'Pengguna';
                var initial = (name.trim().charAt(0) || 'U').toUpperCase();
                var roles = currentUser.roles || [];
                if (currentUser.roleName && roles.indexOf(currentUser.roleName) === -1) {
                    roles.push(currentUser.roleName);
                }

                var isSuper = roles.some(function (r) {
                    var rl = (r || '').toLowerCase();
                    return rl.indexOf('super') !== -1 || rl === 'admin';
                });
                var isFoundationAdmin = isSuper || roles.some(function (r) {
                    var rl = (r || '').toLowerCase();
                    return rl.indexOf('foundation') !== -1 || rl.indexOf('yayasan') !== -1 || rl.indexOf('pengurus') !== -1;
                });

                var dashboardUrl = isFoundationAdmin ? '/Foundation/Dashboard' : '/Donor/Dashboard';
                var donorHistoryUrl = '/Donor/History';
                var donorProfileUrl = '/Donor/Profile';

                $authArea.html(`
                    <div class="dropdown">
                        <button class="user-dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-small">${initial}</div>
                            <span class="ms-1 me-2 fw-semibold text-dark small">${name}</span>
                            <i class="fas fa-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li class="px-3 py-2 border-bottom">
                                <small class="text-muted d-block" style="font-size:11px;">Masuk sebagai</small>
                                <span class="fw-bold text-dark small text-truncate d-block" style="max-width:180px;">${name}</span>
                            </li>
                            <li><a class="dropdown-item py-2" href="${dashboardUrl}"><i class="fas fa-chart-line me-2 text-teal"></i> Dashboard Saya</a></li>
                            ${!isFoundationAdmin ? `
                            <li><a class="dropdown-item py-2" href="${donorHistoryUrl}"><i class="fas fa-clock-rotate-left me-2 text-muted"></i> Riwayat Donasi</a></li>
                            <li><a class="dropdown-item py-2" href="${donorProfileUrl}"><i class="fas fa-user-gear me-2 text-muted"></i> Pengaturan Akun</a></li>
                            ` : ''}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="handlePublicLogout(event)"><i class="fas fa-sign-out-alt me-2"></i> Keluar</a></li>
                        </ul>
                    </div>
                `);
            } else {
                $authArea.html(`
                    <div class="d-flex align-items-center gap-2">
                        <a href="/Auth/Login" class="btn btn-login-nav" id="navLoginBtn">
                            <i class="fas fa-arrow-right-to-bracket me-1"></i> Masuk
                        </a>
                        <a href="/Auth/Register" class="btn btn-outline-teal btn-sm rounded-pill px-3 d-none d-sm-inline-block fw-semibold" id="navRegisterBtn" style="border: 1.5px solid var(--brand-teal); color: var(--brand-teal);">
                            Daftar
                        </a>
                    </div>
                `);
            }
        });
        
        // Global Currency Formatter
        window.formatRupiah = function(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number || 0);
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
