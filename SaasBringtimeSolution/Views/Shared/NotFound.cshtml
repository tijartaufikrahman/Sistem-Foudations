@{
    Layout = null;
    ViewData["Title"] = "404 - Halaman Tidak Ditemukan";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Not Found</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f1f5f9;
            color: #334155;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            text-align: center;
        }
        .error-code {
            font-size: 88px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -2px;
            color: #64748b;
            margin-bottom: 14px;
        }
        .error-title {
            font-size: 20px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 10px;
        }
        .error-desc {
            font-size: 14px;
            color: #64748b;
            line-height: 1.6;
            max-width: 440px;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <div>
        <div class="error-code">404</div>
        <h1 class="error-title">Halaman Tidak Ditemukan</h1>
        <p class="error-desc">Halaman yang Anda tuju tidak tersedia atau tautan yang dimasukkan salah.</p>
    </div>
</body>
</html>
