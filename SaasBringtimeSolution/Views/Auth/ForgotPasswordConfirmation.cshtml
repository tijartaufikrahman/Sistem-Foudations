@{
    ViewData["Title"] = "Kode OTP Terkirim";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kode OTP Terkirim - Bringtime Solution</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image: radial-gradient(circle at 20% 30%, rgba(45,212,191,.15) 0%, transparent 50%),
                              radial-gradient(circle at 80% 70%, rgba(56,189,248,.12) 0%, transparent 50%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px;
            text-align: center;
            border: 1px solid rgba(15,23,42,.06);
        }
        .icon-wrap {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 8px 24px rgba(13,148,136,.25);
        }
        .icon-wrap i { font-size: 32px; color: #ffffff; }
        h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 12px; }
        p { color: #64748b; font-size: 13.5px; line-height: 1.7; margin-bottom: 8px; }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 24px;
            padding: 13px 28px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            color: #ffffff;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 4px 14px rgba(13,148,136,.3);
            transition: all .25s;
        }
        .btn:hover { transform: translateY(-1px); }
        .hint { margin-top: 16px; font-size: 12px; color: #94a3b8; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="fas fa-shield-halved"></i></div>
        <h1>Kode OTP Terkirim!</h1>
        <p>Kode OTP reset password telah dikirim ke email Anda.</p>
        <p>Silakan periksa kotak masuk (<strong>inbox</strong>) atau folder <strong>spam</strong> email Anda.</p>
        <a href="/Auth/VerifyOtp" class="btn">
            <i class="fas fa-key"></i> Masukkan Kode OTP
        </a>
        <div class="hint">Kode OTP berlaku selama 15 menit.</div>
    </div>
</body>
</html>
