        { cls: 'fas fa-tags', name: 'tags label kategori taksonomi penanda' },
        { cls: 'fas fa-folder-tree', name: 'folder tree direktori hierarki berkas' },
        { cls: 'fas fa-cloud-arrow-up', name: 'cloud upload unggah file berkas cadangan' }
    ];

    function renderIconGrid(list) {
        var $grid = $('#iconGridContainer');
        $grid.empty();
        $('#iconMatchCount').text(list.length + ' ikon tersedia');

        if (list.length === 0) {
            $grid.html('<div style="grid-column: 1 / -1; text-align:center; padding:30px; color:#94a3b8;"><i class="fas fa-search" style="font-size:24px; margin-bottom:8px; display:block;"></i>Tidak ada ikon yang cocok</div>');
            return;
        }

        var currentVal = $('#' + activeTargetInput).val();

        list.forEach(function(item) {
            var isSelected = (currentVal === item.cls);
            var card = $(`
                <div class="icon-pick-btn ${isSelected ? 'selected' : ''}" data-class="${item.cls}" title="${item.cls}" style="
                    display:flex; flex-direction:column; align-items:center; justify-content:center;
                    padding:10px 4px; border-radius:8px; border:1px solid ${isSelected ? '#0f766e' : '#e2e8f0'};
                    background:${isSelected ? '#f0fdfa' : '#ffffff'}; cursor:pointer; transition:all 0.15s ease;
                    text-align:center;
                ">
                    <i class="${item.cls}" style="font-size:22px; color:${isSelected ? '#0f766e' : '#334155'}; margin-bottom:6px;"></i>
                    <span style="font-size:10px; color:#64748b; line-height:1.2; word-break:break-all; max-width:100%; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                        ${item.cls.replace('fas fa-', '')}
                    </span>
                </div>
            `);

            card.hover(
                function() { $(this).css({ 'background': '#f8fafc', 'border-color': '#0f766e', 'transform': 'translateY(-2px)' }); },
                function() { 
                    var curSel = ($('#' + activeTargetInput).val() === item.cls);
                    $(this).css({ 
                        'background': curSel ? '#f0fdfa' : '#ffffff', 
                        'border-color': curSel ? '#0f766e' : '#e2e8f0', 
                        'transform': 'none' 
                    }); 
                }
            );

            card.on('click', function() {
                pickIcon(item.cls);
            });

            $grid.append(card);
        });
    }

    window.openIconPicker = function(targetInputId, previewSpanId) {
        activeTargetInput = targetInputId;
        activeTargetPreview = previewSpanId;
        $('#iconPickerSearch').val('');
        renderIconGrid(iconCatalog);
        AdminModal.open('modalIconPicker');
        setTimeout(function() {
            $('#iconPickerSearch').focus();
        }, 150);
    };

    window.pickIcon = function(cls) {
        $('#' + activeTargetInput).val(cls);
        $('#' + activeTargetPreview).html('<i class="' + cls + '"></i>');
        AdminModal.close('modalIconPicker');
        AdminToast.success('Ikon ' + cls + ' dipilih');
    };

    window.filterIcons = function() {
        var query = ($('#iconPickerSearch').val() || '').toLowerCase().trim();
        if (!query) {
            renderIconGrid(iconCatalog);
            return;
        }
        var filtered = iconCatalog.filter(function(item) {
            return item.cls.toLowerCase().includes(query) || item.name.toLowerCase().includes(query);
        });
        renderIconGrid(filtered);
    };

    window.updateIconPreview = function(inputId, previewId) {
        var val = $('#' + inputId).val() || 'fas fa-circle-dot';
        $('#' + previewId).html('<i class="' + val + '"></i>');
    };

    window.openEdit = function (id) {
        var m = allMenus.find(x => x.id === id);
        if (!m) return;

        var iconCls = m.iconClass || m.icon || 'fas fa-circle-dot';
        $('#editId').val(m.id);
        $('#eLabel').val(m.label || m.namaMenu || '');
        $('#eUrl').val(m.routeUrl || m.url || '');
        $('#eIcon').val(iconCls);
        $('#eIconPreview').html('<i class="' + iconCls + '"></i>');
        $('#eFoundationTypeId').val(m.foundationTypeId || '');
        $('#eNote').val(m.note || '');
        $('#eActive').prop('checked', m.isActive !== false);

        AdminModal.open('modalEdit');
    };

    window.submitEdit = function () {
        var id = $('#editId').val();
        var fd = new FormData();
        fd.append('Id', id);
        fd.append('Label', $('#eLabel').val());
        fd.append('RouteUrl', $('#eUrl').val());
        var ftVal = $('#eFoundationTypeId').val();
        if (ftVal) fd.append('FoundationTypeId', ftVal);
        fd.append('IconClass', $('#eIcon').val() || '');
        var currMenu = allMenus.find(function(x) { return x.id == id; });
        fd.append('OrderIndex', currMenu ? (currMenu.orderIndex || 0) : 0);
        if (currMenu && currMenu.parentId) fd.append('ParentId', currMenu.parentId);
        fd.append('Note', $('#eNote').val() || '');
        fd.append('IsActive', $('#eActive').is(':checked'));

        $('#btnSaveEdit').prop('disabled', true).text('Menyimpan...');

        $.ajax({
            url: API_BASE_URL + '/menus/' + id,
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function () {
                $('#btnSaveEdit').prop('disabled', false).text('Perbarui');
                AdminModal.close('modalEdit');
                AdminToast.success('Menu berhasil diperbarui');
                loadMenus();
            },
            error: function (xhr) {
                $('#btnSaveEdit').prop('disabled', false).text('Perbarui');
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal memperbarui menu';
                AdminToast.error(msg);
            }
        });
    };

    window.delMenu = function (id, label) {
        if (confirm('Hapus menu ' + label + '?')) {
            $.ajax({
                url: API_BASE_URL + '/menus/' + id,
                type: 'DELETE',
                dataType: 'json',
                success: function () {
                    AdminToast.success('Menu telah dihapus');
                    loadMenus();
                },
                error: function () {
                    AdminToast.error('Gagal menghapus menu');
                }
            });
        }
    };

    function loadFoundationTypes() {
        $.ajax({
            url: API_BASE_URL + '/FoundationTypes',
            type: 'GET',
            headers: (typeof API_CONFIG !== 'undefined' && API_CONFIG.getHeaders) ? API_CONFIG.getHeaders() : {},
            success: function (res) {
                var types = Array.isArray(res) ? res : (res.data || []);
                var opts = '<option value="">-- Menu Global / Super Admin (Semua Mitra) --</option>';
                var filterOpts = '<option value="">Semua Tipe Mitra</option><option value="global">Menu Global / Super Admin</option>';
                types.forEach(function (t) {
                    opts += `<option value="${t.id}">${escHtml(t.name)}</option>`;
                    filterOpts += `<option value="${t.id}">${escHtml(t.name)}</option>`;
                });
                $('#cFoundationTypeId').html(opts);
                $('#eFoundationTypeId').html(opts);
                $('#filterFoundationType').html(filterOpts);
            }
        });
    }

    window.applyTypeFilter = function () {
        var val = $('#filterFoundationType').val();
        if (!val) {
            renderMenuTable(allMenus);
        } else if (val === 'global') {
            var filtered = allMenus.filter(x => !x.foundationTypeId);
            renderMenuTable(filtered);
        } else {
            var tid = parseInt(val);
            var filtered = allMenus.filter(x => x.foundationTypeId === tid);
            renderMenuTable(filtered);
        }
    };

    $(function () {
        loadMenus();
        loadFoundationTypes();
        renderIconGrid();
    });
</script>
}
