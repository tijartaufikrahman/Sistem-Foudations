@{
    Layout = "_Layout";
    ViewData["Title"] = "Menu";
}

<style>
    /* Scoped styling for Admin Menus */
    .icon-picker-box {
        display: flex;
        gap: 8px;
        align-items: center;
    }
    .icon-preview-box {
        width: 38px;
        height: 38px;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #0f766e;
        flex-shrink: 0;
    }
    #tableMenus th.text-wrap,
    #tableMenus td.text-wrap {
        white-space: normal !important;
        vertical-align: middle !important;
    }
</style>

<!-- Outermost View Wrapper adhering to aturan_styling.txt -->
<div class="row">
    <div class="col-12">

<!-- Breadcrumb Bar: Pojok Kanan Atas Mandiri -->
<div class="content-breadcrumb-bar">
    <div class="breadcrumb-nav" id="pageBreadcrumb">
        <span class="breadcrumb-current">Kelola Menu</span>
        <span class="breadcrumb-separator">/</span>
    </div>
</div>

<!-- Action Bar: Tombol di bawah Breadcrumb -->
<div class="content-action-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
    <button type="button" class="btn-primary-admin" onclick="openCreateModal()">
        <i class="fas fa-plus"></i> Tambah Menu Baru
    </button>
    <div class="d-flex align-items-center gap-2">
        <label for="filterFoundationType" class="form-field-label m-0 fw-semibold text-muted" style="font-size: 12.5px;">Filter Tipe Mitra:</label>
        <select id="filterFoundationType" class="form-field-input" style="width: 250px; height: 38px; padding: 4px 10px;" onchange="applyTypeFilter()">
            <option value="">Semua Tipe Mitra</option>
            <option value="global">Menu Global / Super Admin</option>
        </select>
    </div>
</div>

<div class="admin-card">
    <div class="table-responsive p-3">
        <table class="table table-hover align-middle w-100" id="tableMenus">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px; text-align:center;">NO</th>
                    <th style="width: 60px; text-align:center;">IKON</th>
                    <th class="text-wrap">LABEL MENU</th>
                    <th style="width: 170px;">TIPE MODEL MITRA</th>
                    <th>URL / ROUTE</th>
                    <th>NOTE</th>
                    <th>STATUS</th>
                    <th style="text-align: right; width: 130px;" class="text-wrap">AKSI</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Tambah Menu -->
<div class="admin-modal-backdrop" id="modalCreate">
    <div class="admin-modal-card">
        <div class="admin-modal-head">
            <h4 class="admin-modal-title">Tambah Menu Navigasi</h4>
            <button type="button" class="btn-modal-close" onclick="AdminModal.close('modalCreate')">&times;</button>
        </div>
        <form id="formCreate" onsubmit="event.preventDefault(); submitCreate();">
            <div class="admin-modal-content">
                <div class="form-field-group">
                    <label class="form-field-label">Label Menu <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="cLabel" class="form-field-input" placeholder="Contoh: Manajemen Donasi" required />
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">URL / Route Path <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="cUrl" class="form-field-input" placeholder="Contoh: /Foundations" required />
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">Tipe Model Mitra / Peruntukan Solusi</label>
                    <select id="cFoundationTypeId" class="form-field-input">
                        <option value="">-- Menu Global / Super Admin (Semua Mitra) --</option>
                    </select>
                    <small class="text-muted" style="font-size:11px;">Pilih tipe mitra jika menu ini spesifik untuk modul tertentu (cth: Yayasan Donasi, POS, dsb).</small>
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">FontAwesome Icon Class</label>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span id="cIconPreview" style="width:38px; height:38px; background:#f1f5f9; border:1px solid #cbd5e1; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:18px; color:#0f766e; flex-shrink:0;">
                            <i class="fas fa-circle-dot"></i>
                        </span>
                        <input type="text" id="cIcon" class="form-field-input" value="fas fa-circle-dot" oninput="updateIconPreview('cIcon', 'cIconPreview')" />
                        <button type="button" class="btn-secondary-admin" style="padding:0 12px; height:38px; white-space:nowrap; display:inline-flex; align-items:center; gap:6px;" onclick="openIconPicker('cIcon', 'cIconPreview')">
                            <i class="fas fa-icons text-teal-600"></i> Pilih Ikon
                        </button>
                    </div>
                </div>
                <div class="form-field-group" style="margin-top:12px;">
                    <label class="form-field-label">Note</label>
                    <textarea id="cNote" class="form-field-input" rows="2" placeholder="Contoh: ini untuk super admin / foundation / donor"></textarea>
                    <small class="text-muted" style="font-size:11px;">Sebagai catatan pengingat bahwa menu ini ditujukan untuk siapa.</small>
                </div>
            </div>
            <div class="admin-modal-foot">
                <button type="button" class="btn-secondary-admin" onclick="AdminModal.close('modalCreate')">Batal</button>
                <button type="submit" class="btn-primary-admin" id="btnSaveCreate">Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit Menu -->
<div class="admin-modal-backdrop" id="modalEdit">
    <div class="admin-modal-card">
        <div class="admin-modal-head">
            <h4 class="admin-modal-title">Edit Menu Navigasi</h4>
            <button type="button" class="btn-modal-close" onclick="AdminModal.close('modalEdit')">&times;</button>
        </div>
        <form id="formEdit" onsubmit="event.preventDefault(); submitEdit();">
            <input type="hidden" id="editId" />
            <div class="admin-modal-content">
                <div class="form-field-group">
                    <label class="form-field-label">Label Menu <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="eLabel" class="form-field-input" required />
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">URL / Route Path <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="eUrl" class="form-field-input" required />
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">Tipe Model Mitra / Peruntukan Solusi</label>
                    <select id="eFoundationTypeId" class="form-field-input">
                        <option value="">-- Menu Global / Super Admin (Semua Mitra) --</option>
                    </select>
                    <small class="text-muted" style="font-size:11px;">Pilih tipe mitra jika menu ini spesifik untuk modul tertentu (cth: Yayasan Donasi, POS, dsb).</small>
                </div>
                <div class="form-field-group">
                    <label class="form-field-label">FontAwesome Icon Class</label>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span id="eIconPreview" style="width:38px; height:38px; background:#f1f5f9; border:1px solid #cbd5e1; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:18px; color:#0f766e; flex-shrink:0;">
                            <i class="fas fa-circle-dot"></i>
                        </span>
                        <input type="text" id="eIcon" class="form-field-input" oninput="updateIconPreview('eIcon', 'eIconPreview')" />
                        <button type="button" class="btn-secondary-admin" style="padding:0 12px; height:38px; white-space:nowrap; display:inline-flex; align-items:center; gap:6px;" onclick="openIconPicker('eIcon', 'eIconPreview')">
                            <i class="fas fa-icons text-teal-600"></i> Pilih Ikon
                        </button>
                    </div>
                </div>
                <div class="form-field-group" style="margin-top:12px;">
                    <label class="form-field-label">Note</label>
                    <textarea id="eNote" class="form-field-input" rows="2" placeholder="Contoh: ini untuk super admin / foundation / donor"></textarea>
                    <small class="text-muted" style="font-size:11px;">Sebagai catatan pengingat bahwa menu ini ditujukan untuk siapa.</small>
                </div>
                <div class="form-field-group" style="margin-top:12px;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.8rem; font-weight:600;">
                        <input type="checkbox" id="eActive" style="width:16px; height:16px;" checked />
                        <span>Status Menu Aktif</span>
                    </label>
                </div>
            </div>
            <div class="admin-modal-foot">
                <button type="button" class="btn-secondary-admin" onclick="AdminModal.close('modalEdit')">Batal</button>
                <button type="submit" class="btn-primary-admin" id="btnSaveEdit">Perbarui</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Visual Icon Picker -->
<div class="admin-modal-backdrop modal-stacked" id="modalIconPicker" style="z-index: 3000 !important;">
    <div class="admin-modal-card" style="max-width: 680px; width: 95%;">
        <div class="admin-modal-head">
            <h4 class="admin-modal-title" style="display:flex; align-items:center; gap:8px;">
                <i class="fas fa-icons" style="color:#0f766e;"></i> Pilih Ikon FontAwesome
            </h4>
            <button type="button" class="btn-modal-close" onclick="AdminModal.close('modalIconPicker')">&times;</button>
        </div>
        <div class="admin-modal-content" style="padding:16px 20px;">
            <div style="margin-bottom: 12px; position:relative;">
                <input type="text" id="iconPickerSearch" class="form-field-input" placeholder="Ketik kata kunci untuk mencari ikon (contoh: user, chart, money, settings, heart, gift)..." style="padding-left:36px;" oninput="filterIcons()" />
                <i class="fas fa-search" style="position:absolute; left:12px; top:12px; color:#94a3b8; font-size:14px;"></i>
            </div>
            <div style="font-size:0.75rem; color:#64748b; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
                <span>Klik ikon untuk langsung memilih dan mengisi kolom input.</span>
                <span id="iconMatchCount" style="font-weight:600; color:#0f766e;"></span>
            </div>
            <div id="iconGridContainer" style="display:flex; flex-wrap:wrap; gap:8px; max-height:360px; overflow-y:auto; padding:4px;">
                <!-- Generated dynamically via JS -->
            </div>
        </div>
        <div class="admin-modal-foot">
            <button type="button" class="btn-secondary-admin" onclick="AdminModal.close('modalIconPicker')">Tutup</button>
        </div>
    </div>
</div>

    </div> <!-- Close outer col-12 -->
</div> <!-- Close outer row -->

@section Scripts {
<script>
    var dtMenus = null;
    var allMenus = [];

    function renderMenuTable(menus) {
        if ($.fn.DataTable.isDataTable('#tableMenus')) {
            $('#tableMenus').DataTable().destroy();
        }
        dtMenus = $('#tableMenus').DataTable({
            data: menus || [],
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "Semua"]
            ],
            columns: [
                {
                    data: null,
                    className: "text-center fw-bold text-muted",
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    className: "text-center",
                    render: function (data, type, m) {
                        var iconClass = m.iconClass || m.icon || 'fas fa-circle-dot';
                        return `
                            <span class="stat-icon-wrapper stat-icon-teal" style="width:26px; height:26px; font-size:11px; margin:0 auto;">
                                <i class="${iconClass}"></i>
                            </span>
                        `;
                    }
                },
                {
                    data: 'label',
                    className: "text-wrap align-middle",
                    render: function (data, type, m) {
                        var label = data || m.namaMenu || '';
                        return `<strong style="color:#0f172a;" class="text-wrap d-inline-block">${escHtml(label)}</strong>`;
                    }
                },
                {
                    data: 'foundationTypeName',
                    className: "align-middle",
                    render: function (data) {
                        if (data) {
                            return `<span class="badge" style="background:#ccfbf1; color:#0f766e; border:1px solid #99f6e4; font-size:12px; font-weight:600; padding:4px 8px;"><i class="fas fa-shapes me-1"></i>${escHtml(data)}</span>`;
                        }
                        return '<span class="badge bg-light text-muted border px-2 py-1" style="font-size:11.5px; font-weight:500;">Global / Admin</span>';
                    }
                },
                {
                    data: 'routeUrl',
                    render: function (data, type, m) {
                        var url = data || m.url || '#';
                        return `<span class="code-tag">${escHtml(url)}</span>`;
                    }
                },
                {
                    data: 'note',
                    render: function (data) {
                        if (data) {
                            return `<span class="badge bg-light text-dark border px-2 py-1" style="font-size:11.5px; font-weight:500;">${escHtml(data)}</span>`;
                        }
                        return '<span class="text-muted small">-</span>';
                    }
                },
                {
                    data: 'isActive',
                    render: function (data) {
                        return data !== false
                            ? '<span class="status-pill pill-active"><span class="dot-indicator"></span>Aktif</span>'
                            : '<span class="status-pill pill-inactive"><span class="dot-indicator"></span>Nonaktif</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    className: "text-end text-wrap align-middle",
                    render: function (data, type, m) {
                        var label = m.label || m.namaMenu || '';
                        return `
                            <div class="text-wrap d-inline-flex gap-1 justify-content-end align-items-center">
                                <button type="button" class="btn-table-action btn-table-edit text-wrap" onclick="openEdit(${data})">
                                    <i class="fas fa-pen"></i> Edit
                                </button>
                                <button type="button" class="btn-table-action btn-table-del text-wrap" onclick="delMenu(${data}, '${escHtml(label)}')">
                                    <i class="fas fa-trash"></i> Hapus
                                </button>
                            </div>
                        `;
                    }
                }
            ]
        });
    }

    function loadMenus() {
        $.ajax({
            url: API_BASE_URL + '/menus',
            type: 'GET',
            dataType: 'json',
            success: function (menus) {
                allMenus = menus || [];
                renderMenuTable(allMenus);
            },
            error: function () {
                AdminToast.error('Gagal mengambil data menu');
                renderMenuTable([]);
            }
        });
    }

    window.openCreateModal = function () {
        $('#formCreate')[0].reset();
        $('#cFoundationTypeId').val('');
        $('#cIcon').val('fas fa-circle-dot');
        $('#cIconPreview').html('<i class="fas fa-circle-dot"></i>');
        AdminModal.open('modalCreate');
    };

    window.submitCreate = function () {
        var fd = new FormData();
        fd.append('Label', $('#cLabel').val());
        fd.append('RouteUrl', $('#cUrl').val());
        var ftVal = $('#cFoundationTypeId').val();
        if (ftVal) fd.append('FoundationTypeId', ftVal);
        fd.append('IconClass', $('#cIcon').val() || 'fas fa-circle-dot');
        fd.append('OrderIndex', 0);
        fd.append('Note', $('#cNote').val() || '');

        $('#btnSaveCreate').prop('disabled', true).text('Menyimpan...');

        $.ajax({
            url: API_BASE_URL + '/menus',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function () {
                $('#btnSaveCreate').prop('disabled', false).text('Simpan');
                AdminModal.close('modalCreate');
                AdminToast.success('Menu berhasil ditambahkan');
                loadMenus();
            },
            error: function (xhr) {
                $('#btnSaveCreate').prop('disabled', false).text('Simpan');
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menyimpan menu';
                AdminToast.error(msg);
            }
        });
    }

