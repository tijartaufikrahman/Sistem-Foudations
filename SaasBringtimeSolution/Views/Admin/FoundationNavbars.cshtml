@inject SaasBringtimeSolution.Services.IFoundationService FoundationService
@{
    Layout = "_Layout";
    ViewData["Title"] = "Foundation Navbar";
    var configuredFoundationId = FoundationService.GetConfiguredFoundationId();
}

<style>
    /* Scoped styling for Admin Foundation Navbars Mapping */
    .type-toggle-box {
        display: flex;
        gap: 12px;
        margin-bottom: 6px;
    }
    .type-radio-label {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
        background: #f8fafc;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
    }
    .type-radio-label:hover {
        border-color: #cbd5e1;
        background: #ffffff;
    }
    .type-radio-label:has(input[type="radio"]:checked) {
        border-color: #0f766e;
        background: #f0fdfa;
        color: #0f766e;
    }
    .badge-menu-type {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .badge-standalone {
        background: #f0fdfa;
        color: #0f766e;
        border: 1px solid #ccfbf1;
    }
    .badge-dropdown {
        background: #eef2ff;
        color: #4338ca;
        border: 1px solid #c7d2fe;
    }
    .order-stepper-btn {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        background: #fff;
        border-radius: 4px;
        cursor: pointer;
        color: #475569;
        font-size: 11px;
        transition: all 0.15s;
    }
    .order-stepper-btn:hover {
        border-color: #0f766e;
        color: #0f766e;
        background: #f0fdfa;
    }
    .mock-navbar-preview {
        background: #ffffff;
        border: 1.5px dashed #0d9488;
        border-radius: 10px;
        padding: 12px 18px;
        margin-bottom: 20px;
    }
    .mock-navbar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 10px;
    }
    .mock-nav-items {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .mock-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 12.5px;
        font-weight: 600;
        color: #334155;
    }
    .mock-nav-link.has-dropdown {
        background: #f0fdfa;
        border-color: #99f6e4;
        color: #0f766e;
    }
</style>

<!-- Outermost View Wrapper adhering to aturan_styling.txt -->
<div class="row">
    <div class="col-12">

        <!-- Breadcrumb Bar: Pojok Kanan Atas Mandiri -->
        <div class="content-breadcrumb-bar">
            <div class="breadcrumb-nav" id="pageBreadcrumb">
                <span class="breadcrumb-current">Foundation Navbar</span>
                <span class="breadcrumb-separator">/</span>
            </div>
        </div>

        <!-- Filter Yayasan & Action Bar -->
        <div class="admin-card p-3 mb-4">
            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <label class="form-field-label mb-1">
                        <i class="fas fa-building text-teal me-1"></i> Pilih Mitra / Yayasan:
                    </label>
                    <select id="selectFoundation" class="form-field-select" onchange="onFoundationChange()">
                        <option value="">-- Memuat daftar yayasan... --</option>
                    </select>
                    <div id="portalActiveHint" class="mt-2" style="font-size: 0.8rem;"></div>
                </div>
                <div class="col-md-7 text-md-end pt-md-4">
                    <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                        <button type="button" class="btn-primary-admin" onclick="openAssignModal()">
                            <i class="fas fa-plus"></i> Pasang Menu / Dropdown
                        </button>
                        <button type="button" class="btn-secondary-admin" onclick="resetFoundationNavbarToDefault()" title="Kembalikan susunan menu yayasan ini ke 5 menu standar default">
                            <i class="fas fa-rotate-left"></i> Reset ke Standar
                        </button>
                        <a id="btnPreviewPublicWeb" href="#" target="_blank" class="btn-secondary-admin" style="text-decoration:none;">
                            <i class="fas fa-arrow-up-right-from-square"></i> Buka Web Publik (9007)
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Mock Preview Box -->
        <div class="mock-navbar-preview" id="mockNavbarBox">
            <div class="mock-navbar-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white px-2 py-1" style="background:#0d9488; font-size:11px;">
                        <i class="fas fa-eye me-1"></i> Simulasi Tampilan Navbar Publik
                    </span>
                    <strong class="text-dark" id="previewFoundationName" style="font-size:13px;">Memuat Mitra...</strong>
                    <span class="text-muted small" id="previewFoundationSlug"></span>
                </div>
                <small class="text-muted" style="font-size:11px;">
                    Otomatis tampil di portal web publik mitra (Port 9007)
                </small>
            </div>
            <div class="mock-nav-items" id="mockNavItemsContainer">
                <!-- Populated dynamically via JS -->
            </div>
        </div>

        <!-- Table of Foundation Navbar Items -->
        <div class="admin-card">
            <div class="table-responsive p-3">
                <table class="table table-hover align-middle w-100" id="tableFoundationNavbars">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 75px; text-align:center;">URUTAN</th>
                            <th style="width: 140px; text-align:center;">TIPE NAVIGASI</th>
                            <th>LABEL / NAMA ITEM</th>
                            <th>URL TUJUAN / SUBMENU DROPDOWN</th>
                            <th style="width: 90px; text-align:center;">STATUS</th>
                            <th style="text-align: right; width: 140px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- Modal Pasang Navigasi ke Mitra -->
        <div class="admin-modal-backdrop" id="modalAssign">
            <div class="admin-modal-card" style="max-width: 540px;">
                <div class="admin-modal-head">
                    <h4 class="admin-modal-title">Pasang Menu atau Dropdown ke Mitra</h4>
                    <button type="button" class="btn-modal-close" onclick="AdminModal.close('modalAssign')">&times;</button>
                </div>
                <form id="formAssign" onsubmit="event.preventDefault(); submitAssign();">
                    <div class="admin-modal-content">
                        <div class="form-field-group">
                            <label class="form-field-label">Tipe Navigasi yang Dipasang <span style="color:#ef4444;">*</span></label>
                            <div class="type-toggle-box">
                                <label class="type-radio-label">
                                    <input type="radio" name="assignType" value="standalone" checked onchange="toggleAssignType('standalone')" />
                                    <span><i class="fas fa-link me-1"></i> Menu Mandiri</span>
                                </label>
                                <label class="type-radio-label">
                                    <input type="radio" name="assignType" value="dropdown" onchange="toggleAssignType('dropdown')" />
                                    <span><i class="fas fa-layer-group me-1"></i> Grup Dropdown</span>
                                </label>
                            </div>
                        </div>

                        <!-- Block Menu Mandiri -->
                        <div id="blockStandalone">
                            <div class="form-field-group">
                                <label class="form-field-label">Pilih Butir Menu Navbar <span style="color:#ef4444;">*</span></label>
                                <select id="assignNavbarId" class="form-field-select">
                                    <option value="">-- Pilih Menu Navbar --</option>
                                </select>
                                <small class="text-muted" style="font-size:11px;">Menu yang dipilih akan muncul langsung sebagai link biasa pada navbar.</small>
                            </div>
                        </div>

                        <!-- Block Grup Dropdown -->
                        <div id="blockDropdown" style="display:none;">
                            <div class="form-field-group">
                                <label class="form-field-label">Pilih Grup Dropdown <span style="color:#ef4444;">*</span></label>
                                <select id="assignGroupId" class="form-field-select">
                                    <option value="">-- Pilih Grup Dropdown --</option>
                                </select>
                                <small class="text-muted" style="font-size:11px;">Seluruh butir submenu di bawah grup ini akan muncul sebagai dropdown di navbar.</small>
                            </div>
                        </div>

                        <div class="form-field-group mt-2">
                            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.85rem; font-weight:600;">
                                <input type="checkbox" id="assignActive" style="width:16px; height:16px;" checked />
                                <span>Status Langsung Aktif</span>
                            </label>
                        </div>
                    </div>
                    <div class="admin-modal-foot">
                        <button type="button" class="btn-secondary-admin" onclick="AdminModal.close('modalAssign')">Batal</button>
                        <button type="submit" class="btn-primary-admin" id="btnSaveAssign">Pasang ke Mitra</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    var configuredFoundationId = @configuredFoundationId;
    var currentFoundationId = configuredFoundationId;
    var allFoundations = [];
    var allNavbars = [];
    var allGroups = [];
    var currentAssignedNavbars = [];

    $(function () {
        loadFoundationsDropdown();
        loadMasterDropdowns();
    });

    function clearPublicNavbarCache() {
        try {
            sessionStorage.removeItem('public_navbar_found_' + currentFoundationId);
            sessionStorage.removeItem('public_navbar_found_' + configuredFoundationId);
            localStorage.removeItem('public_navbar_found_' + currentFoundationId);
            localStorage.removeItem('public_navbar_found_' + configuredFoundationId);
        } catch (e) {}
    }

    function cleanDisplayUrl(url) {
        if (!url) return '/';
        var c = url.replace(/\/\{tenant\}/gi, '').replace(/\{tenant\}/gi, '').replace(/\/\{slug\}/gi, '').replace(/\{slug\}/gi, '');
        if (!c) return '/';
        if (!c.startsWith('http') && !c.startsWith('/') && !c.startsWith('#')) c = '/' + c;
        return c;
    }

    function loadMasterDropdowns() {
        $.ajax({
            url: API_BASE_URL + '/navbars',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                allNavbars = (data || []).filter(function (n) { return !n.navbarGroupId; });
                var $sel = $('#assignNavbarId');
                $sel.empty().append('<option value="">-- Pilih Menu Navbar --</option>');
                allNavbars.forEach(function (n) {
                    var displayUrl = cleanDisplayUrl(n.url);
                    $sel.append('<option value="' + n.id + '">' + escHtml(n.title) + ' (' + escHtml(displayUrl) + ')</option>');
                });
            }
        });

        $.ajax({
            url: API_BASE_URL + '/navbargroups',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                allGroups = data || [];
                var $sel = $('#assignGroupId');
                $sel.empty().append('<option value="">-- Pilih Grup Dropdown --</option>');
                allGroups.forEach(function (g) {
                    $sel.append('<option value="' + g.id + '">' + escHtml(g.name) + '</option>');
                });
            }
        });
    }

    function loadFoundationsDropdown() {
        $.ajax({
            url: API_BASE_URL + '/foundations',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                allFoundations = (data || []).filter(function (f) { return f.isActive !== false; });
                var $sel = $('#selectFoundation');
                $sel.empty();

                if (allFoundations.length === 0) {
                    $sel.append('<option value="">Belum ada mitra terdaftar</option>');
                    return;
                }

                allFoundations.forEach(function (f) {
                    var isPortalActive = (f.id === configuredFoundationId);
                    var starLabel = isPortalActive ? ' ⭐ [AKTIF DI PORTAL 9007]' : '';
                    $sel.append('<option value="' + f.id + '">' + escHtml(f.name) + ' (' + escHtml(f.slug || '') + ')' + starLabel + '</option>');
                });

                // Prioritaskan mitra yang sedang aktif di appsettings.json
                var hasConfigured = allFoundations.some(function (f) { return f.id === configuredFoundationId; });
                currentFoundationId = hasConfigured ? configuredFoundationId : allFoundations[0].id;
                $sel.val(currentFoundationId);
                onFoundationChange();
            },
            error: function () {
                AdminToast.error('Gagal mengambil daftar mitra');
            }
        });
    }

    function onFoundationChange() {
        currentFoundationId = parseInt($('#selectFoundation').val() || 0);
        var found = allFoundations.find(function (f) { return f.id === currentFoundationId; });
        var configuredFound = allFoundations.find(function (f) { return f.id === configuredFoundationId; });
        var configuredName = configuredFound ? configuredFound.name : ('ID ' + configuredFoundationId);

        if (found) {
            $('#previewFoundationName').text(found.name);
            $('#previewFoundationSlug').text('(' + (found.slug || '') + ')');
            $('#btnPreviewPublicWeb').attr('href', 'http://localhost:9007/');

            if (currentFoundationId === configuredFoundationId) {
                $('#portalActiveHint').html('<span class="text-success fw-semibold"><i class="fas fa-circle-check me-1"></i> Mitra ini sedang aktif di portal web (Port 9007). Perubahan status langsung diterapkan ke http://localhost:9007/.</span>');
            } else {
                $('#portalActiveHint').html('<span class="text-warning-emphasis fw-semibold"><i class="fas fa-triangle-exclamation me-1"></i> Perhatian: Portal publik (Port 9007) saat ini menjalankan <strong>' + escHtml(configuredName) + '</strong>. Untuk melihat web publik mitra ini, sesuaikan "FoundationId": ' + currentFoundationId + ' di appsettings.json.</span>');
            }
        }
        loadFoundationNavbars();
    }

    function loadFoundationNavbars() {
        if (!currentFoundationId) return;

        $.ajax({
            url: API_BASE_URL + '/foundationnavbars/foundation/' + currentFoundationId,
            type: 'GET',
            dataType: 'json',
            success: function (list) {
                currentAssignedNavbars = list || [];
                renderFoundationNavbarsTable(currentAssignedNavbars);
                renderMockPreview(currentAssignedNavbars);
            },
            error: function () {
                AdminToast.error('Gagal memuat konfigurasi navbar mitra');
            }
        });
    }

    function renderFoundationNavbarsTable(items) {
        if ($.fn.DataTable.isDataTable('#tableFoundationNavbars')) {
            $('#tableFoundationNavbars').DataTable().destroy();
        }

        var $tbody = $('#tableFoundationNavbars tbody');
        $tbody.empty();

        if (items.length === 0) {
            $tbody.html('<tr><td colspan="6" class="text-center py-4 text-muted">Belum ada menu yang dipasang untuk mitra ini. Klik tombol "+ Pasang Menu / Dropdown" di atas.</td></tr>');
            return;
        }

        items.forEach(function (fn) {
            var isDrop = fn.isDropdown;
            var typeBadge = isDrop 
                ? '<span class="badge-menu-type badge-dropdown">Dropdown (' + (fn.childCount || 0) + ')</span>' 
                : '<span class="badge-menu-type badge-standalone">Menu Mandiri</span>';

            var labelHtml = `<span class="fw-bold text-dark">${escHtml(fn.displayLabel)}</span>`;

            var displayUrl = cleanDisplayUrl(fn.navbarUrl);
            var targetUrl = isDrop 
                ? '<span class="text-indigo-600 fw-semibold">' + fn.childCount + ' butir submenu aktif</span>' 
                : '<code class="text-dark">' + escHtml(displayUrl) + '</code>';

            var statusHtml = fn.isActive 
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Aktif</span>' 
                : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Non-Aktif</span>';

            var orderControls = `
                <div class="d-flex align-items-center justify-content-center gap-1">
                    <button type="button" class="order-stepper-btn" onclick="moveFoundationNavbar(${fn.id}, -1)" title="Pindah ke atas/kiri"><i class="fas fa-chevron-up"></i></button>
                    <span class="fw-bold px-1">${fn.orderIndex}</span>
                    <button type="button" class="order-stepper-btn" onclick="moveFoundationNavbar(${fn.id}, 1)" title="Pindah ke bawah/kanan"><i class="fas fa-chevron-down"></i></button>
                </div>
            `;

            var actions = `
                <div class="d-inline-flex gap-1">
                    <button type="button" class="btn-action-icon" title="Toggle Aktif/Nonaktif" onclick="toggleActiveFoundationNavbar(${fn.id}, ${!fn.isActive})">
                        <i class="fas ${fn.isActive ? 'fa-toggle-on text-success' : 'fa-toggle-off text-muted'}" style="font-size:1.1rem;"></i>
                    </button>
                    <button type="button" class="btn-action-icon text-danger" title="Lepas Menu dari Mitra" onclick="deleteFoundationNavbar(${fn.id})">
                        <i class="fas fa-trash-can"></i>
                    </button>
                </div>
            `;

            $tbody.append(`
                <tr>
                    <td class="text-center">${orderControls}</td>
                    <td class="text-center">${typeBadge}</td>
                    <td>${labelHtml}</td>
                    <td>${targetUrl}</td>
                    <td class="text-center">${statusHtml}</td>
                    <td class="text-end">${actions}</td>
                </tr>
            `);
        });
    }

    function renderMockPreview(items) {
        var $container = $('#mockNavItemsContainer');
        $container.empty();

        var activeItems = items.filter(function (x) { return x.isActive !== false; });
        if (activeItems.length === 0) {
            $container.html('<span class="text-muted small">Semua navbar dinonaktifkan atau kosong. Web publik akan menampilkan menu default bawaan sistem.</span>');
            return;
        }

        activeItems.forEach(function (item) {
            if (item.isDropdown) {
                $container.append(`
                    <div class="mock-nav-link has-dropdown">
                        <span>${escHtml(item.displayLabel)}</span>
                        <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i>
                    </div>
                `);
            } else {
                $container.append(`
                    <div class="mock-nav-link">
                        <span>${escHtml(item.displayLabel)}</span>
                    </div>
                `);
            }
        });
    }

    function toggleAssignType(type) {
        if (type === 'dropdown') {
            $('#blockStandalone').hide();
            $('#blockDropdown').show();
        } else {
            $('#blockStandalone').show();
            $('#blockDropdown').hide();
        }
    }

    function openAssignModal() {
        if (!currentFoundationId) {
            AdminToast.error('Pilih mitra terlebih dahulu');
            return;
        }
        $('input[name="assignType"][value="standalone"]').prop('checked', true);
        toggleAssignType('standalone');
        $('#assignNavbarId').val('');
        $('#assignGroupId').val('');
        $('#assignActive').prop('checked', true);
        AdminModal.open('modalAssign');
    }

    function submitAssign() {
        var type = $('input[name="assignType"]:checked').val();
        var navbarId = null;
        var navbarGroupId = null;

        if (type === 'dropdown') {
            var gVal = $('#assignGroupId').val();
            if (!gVal) {
                AdminToast.error('Pilih grup dropdown yang ingin dipasang');
                return;
            }
            navbarGroupId = parseInt(gVal);
        } else {
            var nVal = $('#assignNavbarId').val();
            if (!nVal) {
                AdminToast.error('Pilih menu navbar yang ingin dipasang');
                return;
            }
            navbarId = parseInt(nVal);
        }

        var maxOrder = 0;
        currentAssignedNavbars.forEach(function (x) {
            if (x.orderIndex > maxOrder) maxOrder = x.orderIndex;
        });

        var payload = {
            foundationId: currentFoundationId,
            navbarId: navbarId,
            navbarGroupId: navbarGroupId,
            orderIndex: maxOrder + 1,
            isActive: $('#assignActive').is(':checked')
        };

        $('#btnSaveAssign').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memasang...');
        $.ajax({
            url: API_BASE_URL + '/foundationnavbars',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function () {
                AdminModal.close('modalAssign');
                AdminToast.success('Menu / Dropdown berhasil dipasang ke mitra');
                clearPublicNavbarCache();
                loadFoundationNavbars();
            },
            error: function (xhr) {
                AdminToast.error(xhr.responseJSON?.message || 'Gagal memasang navbar ke mitra');
            },
            complete: function () {
                $('#btnSaveAssign').prop('disabled', false).text('Pasang ke Mitra');
            }
        });
    }

    function moveFoundationNavbar(id, direction) {
        var idx = currentAssignedNavbars.findIndex(function (x) { return x.id === id; });
        if (idx === -1) return;

        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= currentAssignedNavbars.length) return;

        var temp = currentAssignedNavbars[idx];
        currentAssignedNavbars[idx] = currentAssignedNavbars[targetIdx];
        currentAssignedNavbars[targetIdx] = temp;

        var bulk = currentAssignedNavbars.map(function (item, index) {
            return {
                id: item.id,
                orderIndex: index + 1
            };
        });

        $.ajax({
            url: API_BASE_URL + '/foundationnavbars/bulk-sync',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(bulk),
            success: function () {
                clearPublicNavbarCache();
                loadFoundationNavbars();
            },
            error: function () {
                AdminToast.error('Gagal memperbarui urutan navbar');
            }
        });
    }

    function toggleActiveFoundationNavbar(id, newStatus) {
        var item = currentAssignedNavbars.find(function (x) { return x.id === id; });
        if (!item) return;

        var payload = {
            foundationId: item.foundationId,
            navbarId: item.navbarId,
            navbarGroupId: item.navbarGroupId,
            orderIndex: item.orderIndex,
            isActive: newStatus
        };

        $.ajax({
            url: API_BASE_URL + '/foundationnavbars/' + id,
            type: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function () {
                clearPublicNavbarCache();
                loadFoundationNavbars();
            },
            error: function () {
                AdminToast.error('Gagal mengubah status navbar');
            }
        });
    }

    function deleteFoundationNavbar(id) {
        if (!confirm('Apakah Anda yakin ingin melepas navigasi ini dari mitra ini? Master menu aslinya tidak akan terhapus.')) return;
        $.ajax({
            url: API_BASE_URL + '/foundationnavbars/' + id,
            type: 'DELETE',
            success: function () {
                AdminToast.success('Navigasi berhasil dilepas dari mitra');
                clearPublicNavbarCache();
                loadFoundationNavbars();
            },
            error: function () {
                AdminToast.error('Gagal melepas navigasi');
            }
        });
    }

    function resetFoundationNavbarToDefault() {
        if (!currentFoundationId) return;
        if (!confirm('Apakah Anda yakin ingin mengembalikan susunan menu mitra ini ke 5 menu standar default bawaan sistem?')) return;

        $.ajax({
            url: API_BASE_URL + '/foundationnavbars/reset-default/' + currentFoundationId,
            type: 'POST',
            success: function () {
                AdminToast.success('Susunan navbar mitra berhasil direset ke standar default');
                clearPublicNavbarCache();
                loadFoundationNavbars();
            },
            error: function () {
                AdminToast.error('Gagal mereset navbar mitra ke standar');
            }
        });
    }
</script>
}
