@{
    Layout = "_PublicLayout";
    var slug = (ViewData["Slug"] as string) ?? "";
    var tenant = (ViewData["Tenant"] as string) ?? slug;
    var foundationName = (ViewData["FoundationName"] as string) ?? "Yayasan";
    ViewData["Title"] = $"Profile Perusahaan & Lembaga - {foundationName}";
}

<style>
    /* Hero Header */
    .company-hero {
        background: linear-gradient(135deg, #0f766e 0%, #115e59 50%, #042f2e 100%);
        color: #ffffff;
        padding: 5rem 0 4rem 0;
        position: relative;
        overflow: hidden;
    }
    .company-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(45,212,191,0.15) 0%, rgba(255,255,255,0) 70%);
        pointer-events: none;
    }

    .company-logo-circle {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: #ffffff;
        border: 4px solid rgba(255,255,255,0.9);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .badge-verified-company {
        background: rgba(45, 212, 191, 0.15);
        color: #2dd4bf;
        border: 1px solid rgba(45, 212, 191, 0.35);
        border-radius: 50rem;
        padding: 0.35rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Section Cards */
    .company-section-card {
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid #e2e8f0;
        padding: 2.25rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        margin-bottom: 2rem;
    }

    .section-headline {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .section-headline i {
        color: #0d9488;
    }

    /* Value Pillars */
    .pillar-box {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 0.85rem;
        padding: 1.5rem;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .pillar-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        border-color: #cbd5e1;
    }
    .pillar-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #ccfbf1;
        color: #0f766e;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    /* Org Structure Team Cards */
    .team-avatar {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #0f766e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    /* Contact Meta List */
    .contact-spec-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        border-radius: 0.75rem;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
    }
</style>

<div class="row">
    <div class="col-12 px-0">

        <!-- Loading State -->
        <div id="profileLoading" class="text-center py-5 my-5">
            <div class="spinner-border text-teal" role="status" style="color: var(--brand-teal); width: 3rem; height: 3rem;">
                <span class="visually-hidden">Memuat profil lembaga...</span>
            </div>
            <p class="text-muted mt-3">Menghubungkan ke profil resmi lembaga...</p>
        </div>

        <div id="profileContent" style="display: none;">

            <!-- ==========================================
                 COMPANY HERO (IDENTITAS UTAMA LEMBAGA)
                 ========================================== -->
            <section class="company-hero">
                <div class="container">
                    <div class="row align-items-center g-4">
                        <div class="col-md-auto text-center text-md-start">
                            <div class="company-logo-circle mx-auto">
                                <img id="cpLogo" src="https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?w=300" 
                                     alt="Logo Perusahaan / Lembaga" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </div>
                        <div class="col-md text-center text-md-start">
                            <div class="mb-2">
                                <span class="badge-verified-company">
                                    <i class="fas fa-certificate"></i> Badan Hukum Sah & Terverifikasi
                                </span>
                            </div>
                            <h1 class="fw-bold mb-2 text-white" id="cpName" style="letter-spacing: -0.5px;">@foundationName</h1>
                            <p class="lead mb-3 text-white-50" id="cpBio" style="font-size: 1.05rem; max-width: 800px; line-height: 1.6;">
                                Profil Company resmi, dedikasi sosial kemanusiaan, serta tata kelola kelembagaan bagi masyarakat luas.
                            </p>
                            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3 small text-white-50">
                                <span><i class="fas fa-file-shield text-teal me-1" style="color:#2dd4bf;"></i> <span id="cpLegalPermit">-</span></span>
                                <span>•</span>
                                <span><i class="fas fa-location-dot text-teal me-1" style="color:#2dd4bf;"></i> <span id="cpCity">-</span></span>
                                <span>•</span>
                                <span><i class="fas fa-globe text-teal me-1" style="color:#2dd4bf;"></i> <span id="cpDomain">/@tenant</span></span>
                            </div>
                        </div>
                        <div class="col-md-auto text-center text-md-end">
                            <div class="d-flex flex-column gap-2">
                                <a id="btnCpWhatsapp" href="#" target="_blank" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm" style="display:none;">
                                    <i class="fab fa-whatsapp me-2"></i> Hubungi Kantor Resmi
                                </a>
                                <a href="/@tenant" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                    <i class="fas fa-house me-1"></i> Kunjungi Beranda
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==========================================
                 COMPANY BODY CONTENT
                 ========================================== -->
            <section class="py-5" style="background-color: #f8fafc;">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8">

                            <!-- 1. TENTANG LEMBAGA (COMPANY OVERVIEW) -->
                            <div class="company-section-card">
                                <h3 class="section-headline">
                                    <i class="fas fa-building"></i> Tentang Lembaga
                                </h3>
                                <p class="text-secondary mb-3" style="line-height: 1.8;" id="cpAboutDetailed">
                                    <strong id="cpNameInline">@foundationName</strong> adalah organisasi filantropi dan lembaga nirlaba independen berbadan hukum yang didirikan dengan komitmen memberikan solusi nyata terhadap berbagai tantangan sosial kemasyarakatan di Indonesia.
                                </p>
                                <p class="text-secondary mb-0" style="line-height: 1.8;">
                                    Didukung oleh tim manajemen profesional dan tata kelola yang transparan, lembaga ini aktif menginisiasi program pemberdayaan ekonomi keluarga pra-sejahtera, bantuan medis darurat, penyediaan fasilitas pendidikan layak, serta respon cepat tanggap bencana.
                                </p>
                            </div>

                            <!-- 2. VISI & MISI LEMBAGA -->
                            <div class="company-section-card">
                                <h3 class="section-headline">
                                    <i class="fas fa-bullseye"></i> Visi & Misi Perusahaan Lembaga
                                </h3>
                                
                                <div class="mb-4 p-3 rounded-3" style="background: #f0fdfa; border-left: 4px solid #0d9488;">
                                    <strong class="d-block text-dark fw-bold mb-1" style="font-size:1.05rem;">Visi Utama</strong>
                                    <p class="text-secondary mb-0" style="line-height: 1.6;" id="cpVisi">
                                        Menjadi lembaga filantropi terdepan, terpercaya, dan berdaya jangkau luas yang mewujudkan kemandirian serta kesejahteraan masyarakat yang berkeadilan.
                                    </p>
                                </div>

                                <h6 class="fw-bold text-dark mb-3">Misi Strategis:</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-circle-check text-teal mt-1" style="color:#0d9488;"></i>
                                            <p class="small text-secondary mb-0" style="line-height: 1.6;">
                                                Menyelenggarakan program bantuan sosial, pendidikan, dan kesehatan yang tepat sasaran serta berkelanjutan.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-circle-check text-teal mt-1" style="color:#0d9488;"></i>
                                            <p class="small text-secondary mb-0" style="line-height: 1.6;">
                                                Menerapkan tata kelola organisasi yang akuntabel, transparan, dan dapat dipertanggungjawabkan kepada publik.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-circle-check text-teal mt-1" style="color:#0d9488;"></i>
                                            <p class="small text-secondary mb-0" style="line-height: 1.6;">
                                                Membangun jejaring sinergi dan kemitraan strategis dengan instansi pemerintah, swasta, dan para dermawan.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-circle-check text-teal mt-1" style="color:#0d9488;"></i>
                                            <p class="small text-secondary mb-0" style="line-height: 1.6;">
                                                Memanfaatkan teknologi digital untuk memudahkan partisipasi publik serta keterbukaan informasi program.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. NILAI UTAMA & BUDAYA KERJA (CORE VALUES) -->
                            <div class="company-section-card">
                                <h3 class="section-headline">
                                    <i class="fas fa-award"></i> Nilai-Nilai Utama Lembaga
                                </h3>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="pillar-box text-center text-md-start">
                                            <div class="pillar-icon">
                                                <i class="fas fa-hand-holding-heart"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Amanah & Integritas</h6>
                                            <p class="text-muted small mb-0" style="line-height: 1.5;">
                                                Menjaga kepercayaan publik secara sungguh-sungguh dalam setiap pelaksanaan mandat program.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="pillar-box text-center text-md-start">
                                            <div class="pillar-icon">
                                                <i class="fas fa-eye"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Transparansi Publik</h6>
                                            <p class="text-muted small mb-0" style="line-height: 1.5;">
                                                Keterbukaan informasi dan pertanggungjawaban kegiatan secara berkala dan terverifikasi.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="pillar-box text-center text-md-start">
                                            <div class="pillar-icon">
                                                <i class="fas fa-bolt"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Responsif & Sigap</h6>
                                            <p class="text-muted small mb-0" style="line-height: 1.5;">
                                                Hadir dengan cepat merespons kebutuhan mendesak masyarakat yang membutuhkan pertolongan.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 4. STRUKTUR ORGANISASI & TATA KELOLA PENGURUS -->
                            <div class="company-section-card">
                                <h3 class="section-headline">
                                    <i class="fas fa-users-gear"></i> Tata Kelola & Dewan Pengurus
                                </h3>
                                <p class="text-muted small mb-4">
                                    Operasional lembaga dipimpin oleh jajaran dewan pengurus yang berdedikasi dan memiliki integritas tinggi di bidang sosial:
                                </p>
                                <div class="row g-3" id="teamContainer">
                                    <div class="col-md-4 col-sm-6 text-center">
                                        <div class="p-3 border rounded-3 bg-light h-100">
                                            <div class="team-avatar mx-auto"><i class="fas fa-user-tie"></i></div>
                                            <strong class="d-block text-dark small mb-1" id="leadChairpersonName">Ketua Dewan Pengurus</strong>
                                            <span class="badge bg-teal bg-opacity-10 text-teal border px-2 py-1" style="background:#ccfbf1; color:#0f766e; font-size:11px;">Pimpinan Umum</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6 text-center">
                                        <div class="p-3 border rounded-3 bg-light h-100">
                                            <div class="team-avatar mx-auto"><i class="fas fa-user-shield"></i></div>
                                            <strong class="d-block text-dark small mb-1">Sekretaris & Regulasi</strong>
                                            <span class="badge bg-light text-muted border px-2 py-1" style="font-size:11px;">Administrasi & Hukum</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6 text-center">
                                        <div class="p-3 border rounded-3 bg-light h-100">
                                            <div class="team-avatar mx-auto"><i class="fas fa-chart-pie"></i></div>
                                            <strong class="d-block text-dark small mb-1">Bendahara & Audit</strong>
                                            <span class="badge bg-light text-muted border px-2 py-1" style="font-size:11px;">Tata Kelola Keuangan</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- SIDEBAR: DATA LEGALITAS & KONTAK PERUSAHAAN/LEMBAGA -->
                        <div class="col-lg-4">

                            <!-- Kartu Legalitas Hukum Perusahaan -->
                            <div class="company-section-card p-4">
                                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                    <i class="fas fa-certificate text-teal" style="color:#0d9488;"></i> Legalitas & Legal Standing
                                </h5>
                                <div class="mb-3">
                                    <small class="text-muted d-block" style="font-size:11px;">Bentuk Badan Hukum</small>
                                    <strong class="text-dark small">Yayasan Sosial & Filantropi Terdaftar</strong>
                                </div>
                                <div class="mb-0">
                                    <small class="text-muted d-block" style="font-size:11px;">SK Pengesahan Kemenkumham RI</small>
                                    <strong class="text-dark small font-monospace" id="sideLegalNumber">-</strong>
                                </div>
                            </div>

                            <!-- Kartu Kantor & Kontak Resmi -->
                            <div class="company-section-card p-4">
                                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                    <i class="fas fa-headset text-teal" style="color:#0d9488;"></i> Kantor & Layanan Publik
                                </h5>
                                
                                <div class="contact-spec-item mb-3">
                                    <i class="fas fa-map-location-dot text-teal mt-1 fs-5" style="color:#0d9488;"></i>
                                    <div>
                                        <strong class="d-block text-dark small mb-1">Alamat Kantor Resmi</strong>
                                        <p class="text-muted small mb-0" id="sideAddress" style="line-height:1.5;">-</p>
                                    </div>
                                </div>

                                <div class="contact-spec-item mb-3">
                                    <i class="fab fa-whatsapp text-success mt-1 fs-5"></i>
                                    <div>
                                        <strong class="d-block text-dark small mb-1">Layanan WhatsApp & Call Center</strong>
                                        <p class="text-muted small mb-0" id="sideWhatsapp">-</p>
                                    </div>
                                </div>

                                <div class="contact-spec-item mb-3">
                                    <i class="fas fa-clock text-teal mt-1 fs-5" style="color:#0d9488;"></i>
                                    <div>
                                        <strong class="d-block text-dark small mb-1">Jam Operasional Kantor</strong>
                                        <p class="text-muted small mb-0">Senin - Jumat: 08.30 - 17.00 WIB<br>Sabtu: 08.30 - 14.00 WIB</p>
                                    </div>
                                </div>

                                <button type="button" class="btn btn-outline-secondary rounded-pill w-100 py-2 fw-semibold small mt-2" id="btnShareCompanyProfile">
                                    <i class="fas fa-share-nodes me-2"></i> Bagikan Profile Company
                                </button>
                            </div>

                            <!-- Banner Dukungan Kemitraan -->
                            <div class="rounded-4 p-4 text-white position-relative overflow-hidden" 
                                 style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
                                <h6 class="fw-bold text-white mb-2">Kerjasama Kemitraan (CSR)</h6>
                                <p class="small text-white-50 mb-3" style="line-height:1.5;">
                                    Lembaga ini terbuka berkolaborasi dengan perusahaan, institusi, dan komunitas dalam program Corporate Social Responsibility (CSR).
                                </p>
                                <a id="btnCsrWa" href="#" target="_blank" class="btn btn-light rounded-pill btn-sm px-3 fw-bold text-teal" style="color:#0f766e !important;">
                                    <i class="fab fa-whatsapp me-1"></i> Diskusi Kerjasama CSR
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentTenant = '@tenant';

        $(function () {
            if (!currentTenant) {
                $('#profileLoading').html('<div class="alert alert-warning text-center">Identitas yayasan tidak ditentukan.</div>');
                return;
            }

            var fetchUrl = window.CONFIGURED_FOUNDATION_ID 
                ? (API_BASE_URL + '/foundations/' + window.CONFIGURED_FOUNDATION_ID)
                : (API_BASE_URL + '/foundations/slug/' + encodeURIComponent(currentTenant));

            $.ajax({
                url: fetchUrl,
                type: 'GET',
                success: function (f) {
                    if (!f) {
                        $('#profileLoading').html('<div class="alert alert-danger text-center">Profil lembaga tidak ditemukan.</div>');
                        return;
                    }

                    $('#profileLoading').hide();
                    $('#profileContent').show();

                    var fName = f.name || '@foundationName';
                    $('#cpName, #cpNameInline').text(fName);
                    
                    if (f.bio) {
                        $('#cpBio').text(f.bio);
                        $('#cpAboutDetailed').text(f.bio + ' Lembaga ini berfokus pada program pemberdayaan masyarakat, bantuan kemanusiaan darurat, dan peningkatan kualitas hidup penerima manfaat.');
                    }

                    if (f.logoUrl) {
                        $('#cpLogo').attr('src', f.logoUrl);
                    }

                    var legalPermit = f.legalPermitNumber || 'AHU-0018923.AH.01.04.Tahun 2021';
                    $('#cpLegalPermit, #sideLegalNumber').text(legalPermit);

                    var addr = f.address || 'Indonesia';
                    $('#sideAddress').text(addr);
                    var city = addr.split(',').pop().trim();
                    $('#cpCity').text(city || 'Indonesia');

                    var pubUrl = window.location.origin + '/';
                    var domainText = '/';
                    $('#cpDomain, #sideDomainText').text(domainText);
                    $('#sidePubLink').attr('href', pubUrl);

                    var picName = (f.user && f.user.name) ? f.user.name :
                        (f.foundationUsers && f.foundationUsers.length > 0 && f.foundationUsers[0].user && f.foundationUsers[0].user.name) ? f.foundationUsers[0].user.name :
                        'Pimpinan Lembaga';
                    $('#leadChairpersonName').text(picName);

                    if (f.whatsappNumber) {
                        var wa = f.whatsappNumber.replace(/[^0-9]/g, '');
                        if (wa.startsWith('0')) wa = '62' + wa.substring(1);
                        $('#sideWhatsapp').text(f.whatsappNumber);
                        $('#btnCpWhatsapp').attr('href', 'https://wa.me/' + wa + '?text=' + encodeURIComponent('Halo Kantor ' + fName + ', saya ingin berdiskusi seputar profil lembaga.')).show();
                        $('#btnCsrWa').attr('href', 'https://wa.me/' + wa + '?text=' + encodeURIComponent('Halo ' + fName + ', kami tertarik menjalin kerjasama kemitraan / program CSR.')).show();
                    } else {
                        $('#sideWhatsapp').text('-');
                        $('#btnCpWhatsapp').hide();
                    }
                },
                error: function () {
                    $('#profileLoading').html('<div class="alert alert-danger text-center py-4"><h5>Lembaga Tidak Ditemukan</h5><p class="text-muted">Profil lembaga dengan alamat ini belum terdaftar atau telah dinonaktifkan.</p><a href="/" class="btn btn-brand rounded-pill px-4">Kembali ke Beranda</a></div>');
                }
            });

            $('#btnShareCompanyProfile').on('click', function () {
                var url = window.location.href;
                if (navigator.share) {
                    navigator.share({
                        title: $('#cpName').text(),
                        text: 'Profil resmi lembaga ' + $('#cpName').text(),
                        url: url
                    }).catch(function () { });
                } else {
                    navigator.clipboard.writeText(url).then(function () {
                        alert('Tautan profil lembaga berhasil disalin ke clipboard!');
                    });
                }
            });
        });
    </script>
}
