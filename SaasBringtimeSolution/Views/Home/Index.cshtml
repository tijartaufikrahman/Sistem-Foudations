@{
    Layout = "_PublicLayout";
    var slug = (ViewData["Slug"] as string) ?? "";
    var domain = (ViewData["Domain"] as string) ?? "";
    var tenant = (ViewData["Tenant"] as string) ?? (!string.IsNullOrEmpty(slug) ? slug : domain);
    var foundationName = (ViewData["FoundationName"] as string) ?? "Yayasan";
    ViewData["Title"] = $"{foundationName} - Beranda Portal Donasi Resmi";
}



<!-- =======================================================
     SIKLUS 1: HERO SECTION DENGAN SPOTLIGHT KISAH NYATA
     ======================================================= -->
<section class="hero-v3 border-bottom">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <!-- Kolom Kiri: Narasi & Pencarian -->
            <div class="col-lg-7 text-center text-lg-start">
                <div class="hero-badge-pill">
                    <i class="fas fa-heart text-danger"></i> Portal Donasi Resmi & Terverifikasi
                </div>
                
                <h1 class="hero-title-v3">
                    Setiap Kebaikan Kecil<br>
                    <span style="color: var(--brand-teal);">Menghadirkan Harapan Besar.</span>
                </h1>

                <p class="hero-subtitle-v3 mx-auto mx-lg-0" id="heroSubtitle">
                    Bantu mereka yang sedang berjuang hari ini: pengobatan anak sakit kritis, 
                    santunan anak yatim piatu, hingga bantuan pangan keluarga dhuafa melalui program kebaikan resmi @foundationName.
                </p>

                <!-- Search Bar Ramah Pengguna -->
                <div class="hero-search-wrapper mb-3 mx-auto mx-lg-0" style="max-width: 580px;">
                    <i class="fas fa-magnifying-glass text-muted fs-5 me-2"></i>
                    <input type="text" id="landingSearch" class="hero-search-input" 
                           placeholder="Cari program donasi, nama pasien, kategori, bantuan..." />
                    <button type="button" class="btn btn-brand rounded-pill px-4 py-2 fw-semibold" id="btnSearchTrigger">
                        Cari
                    </button>
                </div>
            </div>

            <!-- Kolom Kanan: Spotlight Kisah Kemanusiaan Nyata -->
            <div class="col-lg-5">
                <div class="featured-story-card position-relative mx-auto" style="max-width: 420px;" id="heroStoryCard">
                    <div class="position-relative" style="height: 220px; overflow: hidden;">
                        <img id="heroStoryImg" src="https://images.unsplash.com/photo-1516549655169-df83a0774514?w=800" 
                             alt="Program Pilihan" style="width: 100%; height: 100%; object-fit: cover;">
                        <span class="story-badge-urgent" id="heroStoryBadge">
                            <i class="fas fa-heart-pulse me-1"></i> MENDESAK HARI INI
                        </span>
                    </div>
                    <div class="p-4 bg-white">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img id="heroStoryFoundLogo" src="https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=60" 
                                 class="rounded-circle" style="width: 22px; height: 22px; object-fit: cover;">
                            <small class="text-muted fw-semibold text-truncate" id="heroStoryFoundName" style="max-width: 250px;">
                                @foundationName
                            </small>
                            <i class="fas fa-circle-check text-teal ms-auto small" style="color:var(--brand-teal);"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-3" id="heroStoryTitle" 
                            style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
                            Bantuan Kemanusiaan & Sedekah Kebaikan
                        </h5>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted" style="font-size: 11.5px;">Terkumpul</span>
                                <span class="fw-bold text-teal" id="heroStoryProgressTxt" style="color: var(--brand-teal);">0%</span>
                            </div>
                            <div class="progress" style="height: 8px; border-radius: 4px; background: #e2e8f0;">
                                <div class="progress-bar" id="heroStoryProgressBar" style="width: 0%; background: linear-gradient(90deg, #0d9488, #2dd4bf);"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-baseline mt-2">
                                <strong class="text-dark" id="heroStoryCollected">Rp 0</strong>
                                <small class="text-muted" id="heroStoryTarget">Target Rp 0</small>
                            </div>
                        </div>
                        <a id="heroStoryBtnDonate" href="/Campaigns" class="btn btn-brand rounded-pill w-100 py-2 fw-bold text-white shadow-sm">
                            <i class="fas fa-heart me-1"></i> Bantu Sekarang
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =======================================================
     SIKLUS 2: TRUST STRIP MINIMALIS
     ======================================================= -->
<div class="trust-strip-clean">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-center justify-content-md-between align-items-center gap-3">
            <div class="trust-item-clean">
                <i class="fas fa-shield-halved text-teal fs-5" style="color: var(--brand-teal);"></i>
                <span>Yayasan Berbadan Hukum Resmi</span>
            </div>
            <div class="trust-item-clean">
                <i class="fas fa-qrcode text-teal fs-5" style="color: var(--brand-teal);"></i>
                <span>Donasi Instan QRIS & Semua Bank</span>
            </div>
            <div class="trust-item-clean">
                <i class="fas fa-receipt text-teal fs-5" style="color: var(--brand-teal);"></i>
                <span>Bukti Kuitansi Elektronik Sah</span>
            </div>
            <div class="trust-item-clean">
                <i class="fas fa-file-invoice text-teal fs-5" style="color: var(--brand-teal);"></i>
                <span>Laporan Penyaluran (LPJ) Terbuka</span>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     SIKLUS 3 & 4: KATEGORI CEPAT & PROGRAM CAMPAIGN
     ======================================================= -->
<section class="py-5" id="campaigns" style="background-color: var(--bg-light);">
    <div class="container">
        <!-- Header Section -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">Program Bantuan Pilihan</h3>
                <p class="text-muted small mb-0">Pilih program dan salurkan kepedulian Anda langsung kepada mereka yang membutuhkan.</p>
            </div>
            <div class="small text-muted fw-semibold">
                Menampilkan: <span class="text-dark" id="campaignCountBadge">Memuat...</span>
            </div>
        </div>

        <!-- Horizontal Scrollable Category Pills -->
        <div class="category-pill-scroll mb-4" id="categoryPillBar">
            <button type="button" class="category-pill-btn active" data-cat="all">
                <i class="fas fa-shapes text-teal"></i> Semua Program
            </button>
            <button type="button" class="category-pill-btn" data-cat="bencana_alam">
                <i class="fas fa-house-chimney-crack text-danger"></i> Bencana Alam
            </button>
            <button type="button" class="category-pill-btn" data-cat="kesehatan">
                <i class="fas fa-heart-pulse text-danger"></i> Medis & Pengobatan
            </button>
            <button type="button" class="category-pill-btn" data-cat="yatim">
                <i class="fas fa-children text-warning"></i> Yatim & Dhuafa
            </button>
            <button type="button" class="category-pill-btn" data-cat="pendidikan">
                <i class="fas fa-graduation-cap text-primary"></i> Pendidikan
            </button>
            <button type="button" class="category-pill-btn" data-cat="sosial">
                <i class="fas fa-bowl-food text-success"></i> Sedekah Pangan
            </button>
        </div>

        <!-- Campaign Grid -->
        <div class="row g-4" id="campaignList">
            <!-- Skeleton Shimmer Placeholder -->
            <div class="col-md-6 col-lg-4">
                <div class="campaign-card-clean p-3 bg-white">
                    <div class="skeleton-box mb-3" style="height: 180px;"></div>
                    <div class="skeleton-box mb-2" style="height: 20px; width: 80%;"></div>
                    <div class="skeleton-box mb-3" style="height: 14px; width: 60%;"></div>
                    <div class="skeleton-box" style="height: 38px;"></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="campaign-card-clean p-3 bg-white">
                    <div class="skeleton-box mb-3" style="height: 180px;"></div>
                    <div class="skeleton-box mb-2" style="height: 20px; width: 80%;"></div>
                    <div class="skeleton-box mb-3" style="height: 14px; width: 60%;"></div>
                    <div class="skeleton-box" style="height: 38px;"></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="campaign-card-clean p-3 bg-white">
                    <div class="skeleton-box mb-3" style="height: 180px;"></div>
                    <div class="skeleton-box mb-2" style="height: 20px; width: 80%;"></div>
                    <div class="skeleton-box mb-3" style="height: 14px; width: 60%;"></div>
                    <div class="skeleton-box" style="height: 38px;"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =======================================================
     SIKLUS 7: UNTAIAN DOA & TESTIMONI ORANG BAIK
     ======================================================= -->
<section class="py-5" id="prayers" style="background-color: var(--bg-light);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <h3 class="fw-bold text-dark mb-1">Untaian Doa Sesama Orang Baik</h3>
                <p class="text-muted small mb-0">Doa-doa tulus yang menyertai setiap rupiah kebaikan yang disalurkan.</p>
            </div>
        </div>

        <div class="row g-3" id="prayerWallList">
            <div class="col-12 text-center py-4">
                <div class="spinner-border text-teal spinner-border-sm" role="status"></div>
            </div>
        </div>
    </div>
</section>


<!-- =======================================================
     SIKLUS 9: FAQ RINGKAS & RELEVAN BAGI DONATUR
     ======================================================= -->
<section class="py-5" id="faq" style="background-color: var(--bg-light);">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-4">
            <h3 class="fw-bold text-dark mb-1">Pertanyaan yang Sering Diajukan</h3>
            <p class="text-muted small">Jawaban jelas seputar keamanan, transparansi, dan penyaluran donasi Anda.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion" id="accordionFaqSimple">
                    <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-xs">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#f1">
                                Apakah donasi saya langsung disalurkan oleh yayasan?
                            </button>
                        </h2>
                        <div id="f1" class="accordion-collapse collapse show" data-bs-parent="#accordionFaqSimple">
                            <div class="accordion-body text-muted small" style="line-height: 1.6;">
                                Ya. Seluruh dana donasi yang terverifikasi dialokasikan khusus untuk campaign terkait dan disalurkan langsung melalui rekening bank resmi berbadan hukum milik yayasan pengelola program.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-xs">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#f2">
                                Apakah saya bisa berdonasi tanpa mencantumkan nama asli (Hamba Allah)?
                            </button>
                        </h2>
                        <div id="f2" class="accordion-collapse collapse" data-bs-parent="#accordionFaqSimple">
                            <div class="accordion-body text-muted small" style="line-height: 1.6;">
                                Tentu bisa. Anda cukup mencentang opsi <em>"Sembunyikan nama saya (Donasi Anonim)"</em> saat mengisi formulir. Nama Anda akan tertulis sebagai "Hamba Allah" di daftar publik, namun bukti kuitansi sah tetap Anda terima.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-xs">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#f3">
                                Bagaimana cara mendapatkan bukti kuitansi pembayaran donasi?
                            </button>
                        </h2>
                        <div id="f3" class="accordion-collapse collapse" data-bs-parent="#accordionFaqSimple">
                            <div class="accordion-body text-muted small" style="line-height: 1.6;">
                                Begitu transaksi dinyatakan lunas (PAID), sistem secara otomatis menerbitkan tanda terima resmi berstempel digital yang dapat Anda cetak atau unduh langsung dalam format PDF di halaman status pembayaran atau menu riwayat donasi.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-xs">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#f4">
                                Apa saja metode pembayaran yang dapat digunakan?
                            </button>
                        </h2>
                        <div id="f4" class="accordion-collapse collapse" data-bs-parent="#accordionFaqSimple">
                            <div class="accordion-body text-muted small" style="line-height: 1.6;">
                                Kami menerima pembayaran instan via <strong>QRIS Nasional</strong> (bisa di-scan dari GoPay, OVO, DANA, LinkAja, ShopeePay, dan seluruh m-banking) serta <strong>Virtual Account resmi</strong> (Bank Mandiri, BCA, BNI, BSI) dengan verifikasi otomatis 24 jam.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =======================================================
     SIKLUS 10: CTA PENUTUP BERSIH SEBELUM FOOTER
     ======================================================= -->
<section class="py-5 text-center bg-white border-top">
    <div class="container py-3">
        <h3 class="fw-bold text-dark mb-2">Mari Bersama Bantu Saudara Kita Hari Ini</h3>
        <p class="text-muted small mx-auto mb-4" style="max-width: 500px;">
            Satu kebaikan yang Anda salurkan hari ini bisa menyelamatkan kehidupan mereka esok hari.
        </p>
        <a href="#campaigns" class="btn btn-brand rounded-pill px-5 py-3 fw-bold text-white shadow-sm">
            <i class="fas fa-heart me-2"></i> Pilih Program Donasi Sekarang
        </a>
    </div>
</section>

@section Scripts {
    <script>
        var currentTenant = '@tenant';
        var currentSlug = '@slug';
        var currentDomain = '@domain';

        // Auto-detect dari path URL jika belum terisi
        if (!currentTenant) {
            var pathParts = window.location.pathname.split('/').filter(Boolean);
            if (pathParts.length > 0) {
                var p = pathParts[0].toLowerCase();
                var reserved = ['admin', 'donor', 'foundation', 'account', 'public', 'home', 'kemitraan', 'superadmin', 'api', 'join'];
                if (reserved.indexOf(p) === -1) {
                    currentTenant = pathParts[0];
                }
            }
            if (!currentTenant) {
                currentTenant = new URLSearchParams(window.location.search).get('tenant') || 
                                new URLSearchParams(window.location.search).get('slug') || 
                                new URLSearchParams(window.location.search).get('domain') || '';
            }
        }


        $(function () {
            var rawCampaigns = [];
            var activeCategory = 'all';
            var searchQuery = '';
            var foundationObj = null;

            if (!currentTenant) {
                currentTenant = window.CONFIGURED_FOUNDATION_SLUG || '';
            }

            // 1. Ambil Profil Yayasan Spesifik dari ID konfigurasi
            var fetchUrl = window.CONFIGURED_FOUNDATION_ID 
                ? (API_BASE_URL + '/foundations/' + window.CONFIGURED_FOUNDATION_ID)
                : (API_BASE_URL + '/foundations/slug/' + encodeURIComponent(currentTenant));

            $.ajax({
                url: fetchUrl,
                type: 'GET',
                dataType: 'json',
                success: function (f) {
                    if (!f || (!f.id && !f.Id)) {
                        $('section').not('#notFoundSection').hide();
                        $('#notFoundSection').show();
                        return;
                    }

                    foundationObj = f;
                    var fName = f.name || f.Name || 'Yayasan Mitra';
                    var fSlug = f.slug || f.Slug || currentTenant;
                    var fLogo = f.logoUrl || f.LogoUrl || '';
                    var fBio = f.bio || f.Bio || 'Mendedikasikan diri untuk kemaslahatan umat dan transparansi penyaluran bantuan.';
                    var fLegal = f.legalPermitNumber || f.LegalPermitNumber || '-';
                    var fAddress = f.address || f.Address || 'Kantor Sekretariat Yayasan';
                    var fBank = f.bankName || f.BankName || 'Bank Syariah';
                    var fBankNum = f.bankAccountNumber || f.BankAccountNumber || '-';
                    var fBankHolder = f.bankAccountHolder || f.BankAccountHolder || fName;
                    var fWa = f.whatsappNumber || f.WhatsappNumber || '';

                    document.title = fName + ' - Situs Web Resmi & Portal Donasi Mandiri';

                    // Update Subtitle & Brand Spotlight
                    $('#heroSubtitle').text('Bantu mereka yang sedang berjuang hari ini: pengobatan anak sakit kritis, santunan anak yatim piatu, hingga bantuan pangan keluarga dhuafa melalui program kebaikan resmi ' + fName + '.');
                    $('#heroStoryFoundName').text(fName);
                    if (fLogo) {
                        $('#heroStoryFoundLogo').attr('src', fLogo);
                    }

                    // Update Navbar
                    $('#navFoundName').text(fName);
                    if (fLogo && $('#navFoundLogoBox').length) {
                        $('#navFoundLogoBox').html('<img src="' + fLogo + '" style="width:100%;height:100%;object-fit:cover;">');
                    }
                    $('#yayasanNavBrand').attr('href', '/');
                    $('#navLoginBtn').attr('href', '/Auth/Login');
                    $('#navRegisterBtn').attr('href', '/Auth/Register');


                    // Update Footer
                    $('#footerFoundTitle').text(fName);
                    $('#footerCopyName').text(fName);
                    if (fBio) $('#footerFoundBio').text(fBio);
                    if (fLegal !== '-') $('#footerFoundLegalTxt').text('SK Kemenkumham No. ' + fLegal);
                    $('#footerBankName').text(fBank + ' a.n ' + fBankHolder);
                    $('#footerBankNumber').text(fBankNum);

                    // 2. Ambil Campaign Milik Yayasan Ini Saja
                    loadCampaigns(f.id, fName, fLogo);
                },
                error: function (xhr) {
                    $('#campaignList').html('<div class="col-12 text-center py-5 text-muted">Belum ada program donasi aktif saat ini.</div>');
                }
            });

            function loadCampaigns(foundationId, fName, fLogo) {
                $.ajax({
                    url: API_BASE_URL + '/campaigns/foundation/' + foundationId,
                    type: 'GET',
                    success: function (data) {
                        var list = data || [];
                        rawCampaigns = list.filter(function (c) { return c.isActive !== false; });

                        // Isi data Spotlight Hero dari campaign teratas / paling mendesak milik yayasan ini
                        if (rawCampaigns.length > 0) {
                            var featured = rawCampaigns[0];
                            $('#heroStoryTitle').text(featured.title);
                            if (featured.bannerUrl) $('#heroStoryImg').attr('src', featured.bannerUrl);

                            var fProg = featured.targetAmount > 0 ? Math.min(100, Math.round((featured.collectedAmount / featured.targetAmount) * 100)) : 0;
                            $('#heroStoryProgressTxt').text(fProg + '%');
                            $('#heroStoryProgressBar').css('width', fProg + '%');
                            $('#heroStoryCollected').text(formatRupiah(featured.collectedAmount || 0));
                            $('#heroStoryTarget').text('Target ' + formatRupiah(featured.targetAmount || 0));
                            $('#heroStoryBtnDonate').attr('href', '/Donate/' + encodeURIComponent(featured.slug));

                            $('#heroStoryFoundName').text(fName);
                            if (fLogo) $('#heroStoryFoundLogo').attr('src', fLogo);
                        } else {
                            $('#heroStoryTitle').text('Program Kebaikan ' + fName);
                            $('#heroStoryBtnDonate').attr('href', '#campaigns');
                        }

                        renderCampaignGrid();
                    },
                    error: function () {
                        $('#campaignList').html('<div class="col-12 text-center py-4 text-danger">Gagal memuat program donasi yayasan.</div>');
                    }
                });
            }

            // 3. Render Grid Campaign dengan Filter & Search
            function renderCampaignGrid() {
                var fName = foundationObj ? (foundationObj.name || foundationObj.Name || 'Yayasan') : '@foundationName';
                var fLogo = foundationObj ? (foundationObj.logoUrl || foundationObj.LogoUrl || 'https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=60') : 'https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=60';

                var filtered = rawCampaigns.filter(function (c) {
                    var matchesCat = (activeCategory === 'all') || ((c.category || '').toLowerCase() === activeCategory.toLowerCase());
                    var matchesSearch = true;
                    if (searchQuery) {
                        var q = searchQuery.toLowerCase();
                        var titleMatch = (c.title || '').toLowerCase().indexOf(q) !== -1;
                        var catMatch = (c.category || '').toLowerCase().indexOf(q) !== -1;
                        matchesSearch = titleMatch || catMatch;
                    }
                    return matchesCat && matchesSearch;
                });

                $('#campaignCountBadge').text(filtered.length + ' Program');

                if (filtered.length > 0) {
                    var html = '';
                    filtered.forEach(function (c) {
                        var bannerUrl = c.bannerUrl || 'https://images.unsplash.com/photo-1593113598332-cd288d649433?w=600';
                        var progress = c.targetAmount > 0 ? Math.min(100, Math.round((c.collectedAmount / c.targetAmount) * 100)) : 0;
                        var categoryText = c.category ? c.category.replace('_', ' ').toUpperCase() : 'DONASI';

                        html += `
                            <div class="col-md-6 col-lg-4">
                                <div class="campaign-card-clean">
                                    <div>
                                        <div class="campaign-img-clean">
                                            <img src="${bannerUrl}" alt="${c.title}">
                                            <span class="campaign-tag-clean">${categoryText}</span>
                                        </div>
                                        <div class="p-3">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <img src="${fLogo}" alt="${fName}" class="rounded-circle" style="width:20px;height:20px;object-fit:cover;">
                                                <small class="text-muted fw-semibold text-truncate" style="max-width: 220px;">${fName}</small>
                                                <i class="fas fa-circle-check text-teal ms-auto small" style="color:var(--brand-teal);"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.4;font-size:1rem;">
                                                <a href="/Campaign/${encodeURIComponent(c.slug)}" class="text-decoration-none text-dark hover-teal">
                                                    ${c.title}
                                                </a>
                                            </h5>
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between small mb-1">
                                                    <span class="text-muted" style="font-size: 11px;">Terkumpul</span>
                                                    <span class="fw-bold text-teal" style="color:var(--brand-teal); font-size:11px;">${progress}%</span>
                                                </div>
                                                <div class="progress" style="height: 6px; border-radius: 3px; background: #e2e8f0;">
                                                    <div class="progress-bar" style="width: ${progress}%; background: linear-gradient(90deg, #0d9488, #2dd4bf);"></div>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-baseline mb-3">
                                                <div>
                                                    <small class="text-muted d-block" style="font-size:10.5px;">Dana Terkumpul</small>
                                                    <span class="fw-bold text-dark" style="font-size:13.5px;">${formatRupiah(c.collectedAmount)}</span>
                                                </div>
                                                <div class="text-end">
                                                    <small class="text-muted d-block" style="font-size:10.5px;">Target</small>
                                                    <span class="text-muted small" style="font-size:11.5px;">${formatRupiah(c.targetAmount)}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-3 pt-0 d-flex gap-2">
                                        <a href="/Campaign/${encodeURIComponent(c.slug)}" class="btn btn-light rounded-pill btn-sm w-50 py-2 fw-semibold text-muted border">
                                            Detail Kisah
                                        </a>
                                        <a href="/Donate/${encodeURIComponent(c.slug)}" class="btn btn-brand rounded-pill btn-sm w-50 py-2 fw-bold text-white shadow-sm">
                                            <i class="fas fa-heart me-1"></i> Donasi
                                        </a>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    $('#campaignList').html(html);
                } else {
                    $('#campaignList').html(`
                        <div class="col-12 text-center py-5 bg-white rounded-4 border">
                            <div class="mb-2"><i class="fas fa-search text-muted fa-2x opacity-50"></i></div>
                            <h6 class="fw-bold text-dark mb-1">Tidak ada program yang sesuai</h6>
                            <p class="text-muted small mb-3">Coba pilih kategori lain atau hapus kata kunci pencarian Anda.</p>
                            <button class="btn btn-outline-brand rounded-pill btn-sm px-4" onclick="$('.category-pill-btn[data-cat=all]').click(); $('#landingSearch').val('').trigger('input');">
                                Tampilkan Semua Program
                            </button>
                        </div>
                    `);
                }
            }

            // 4. Ambil Doa Donatur Nyata
            $.ajax({
                url: API_BASE_URL + '/donations',
                type: 'GET',
                success: function (donations) {
                    var list = donations || [];
                    var prayers = list.filter(function (d) { 
                        return d.prayerMessage && d.prayerMessage.trim().length > 3; 
                    });

                    if (prayers.length === 0) {
                        prayers = [
                            { id: 1, donorName: 'Ibu Rahmawati', prayerMessage: 'Semoga adik manis lekas sembuh dan bisa ceria kembali bersama keluarga tercinta.', aamiinCount: 28 },
                            { id: 2, donorName: 'Hamba Allah', isAnonymous: true, prayerMessage: 'Sedekah atas nama orang tua kami. Semoga berkah dan menjadi amal jariyah.', aamiinCount: 45 },
                            { id: 3, donorName: 'Ahmad Fauzi', prayerMessage: 'Bismillah, semoga bermanfaat bagi saudara-saudara kita dan berkah melimpah.', aamiinCount: 19 }
                        ];
                    }

                    var html = '';
                    prayers.slice(0, 3).forEach(function (p) {
                        var dName = p.isAnonymous ? 'Hamba Allah (Anonim)' : (p.donorName || 'Orang Baik');
                        var aamiinVal = p.aamiinCount || 0;
                        html += `
                            <div class="col-md-4">
                                <div class="prayer-card-clean bg-white">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-teal bg-opacity-10 text-teal fw-bold d-flex align-items-center justify-content-center" style="width:30px;height:30px;font-size:11px;color:var(--brand-teal);">
                                                    <i class="fas fa-heart"></i>
                                                </div>
                                                <span class="fw-bold text-dark small">${dName}</span>
                                            </div>
                                            <i class="fas fa-quote-right text-muted opacity-25 small"></i>
                                        </div>
                                        <p class="fst-italic text-muted small mb-3" style="line-height:1.5;">
                                            "${p.prayerMessage}"
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <small class="text-muted" style="font-size:11px;"><i class="fas fa-hands-praying text-teal me-1"></i> Doa Bersama</small>
                                        <button type="button" class="btn-aamiin-clean" data-id="${p.id}">
                                            <i class="fas fa-heart text-danger me-1"></i> Aamiin (<span class="aamiin-counter">${aamiinVal}</span>)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    $('#prayerWallList').html(html);
                }
            });

            // Klik Tombol Aamiin
            $(document).on('click', '.btn-aamiin-clean', function () {
                var $btn = $(this);
                if ($btn.hasClass('voted')) return;
                
                var $counter = $btn.find('.aamiin-counter');
                var current = parseInt($counter.text()) || 0;
                $counter.text(current + 1);
                $btn.addClass('voted');

                var donationId = $btn.data('id');
                if (donationId) {
                    $.post(API_BASE_URL + '/donations/' + donationId + '/aamiin').fail(function() {});
                }
            });

            // Klik Category Pills
            $('.category-pill-btn').on('click', function () {
                $('.category-pill-btn').removeClass('active');
                $(this).addClass('active');
                activeCategory = $(this).data('cat');
                renderCampaignGrid();
            });

            // Input Pencarian
            $('#landingSearch').on('input', function () {
                searchQuery = $(this).val().trim();
                renderCampaignGrid();
            });

            $('#btnSearchTrigger').on('click', function () {
                $('html, body').animate({
                    scrollTop: $("#campaigns").offset().top - 80
                }, 400);
            });

            $('.search-chip').on('click', function (e) {
                e.preventDefault();
                var q = $(this).data('query');
                $('#landingSearch').val(q);
                searchQuery = q;
                renderCampaignGrid();
                $('html, body').animate({
                    scrollTop: $("#campaigns").offset().top - 80
                }, 400);
            });
        });
    </script>
}
