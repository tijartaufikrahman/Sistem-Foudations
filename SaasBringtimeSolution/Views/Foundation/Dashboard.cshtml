@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<style>
    /* Scoped custom style for Foundation Dashboard */
    .fnd-dash-progress-track {
        height: 6px;
        background: #f1f5f9;
        border-radius: 4px;
    }
    .fnd-dash-progress-fill {
        background: #0f766e;
        border-radius: 4px;
    }
    .fnd-dash-action-card {
        background: #ffffff;
        color: #334155;
        transition: all 0.2s ease;
    }
    .fnd-dash-action-card:hover {
        background: #f8fafc;
        transform: translateX(4px);
    }
</style>

<!-- Outermost View Wrapper adhering to aturan_styling.txt -->
<div class="row">
    <div class="col-12">


<!-- 3 Key Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Total Donasi Diterima</span>
                <div class="stat-icon-wrapper stat-icon-teal">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value" id="statTotalDonasi">Rp 0</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-active" style="padding:1px 6px; font-size:10px;">Terverifikasi</span>
                    <span>Status Paid</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Campaign Aktif</span>
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i class="fas fa-bullhorn"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value" id="statCampaign">0</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-role" style="padding:1px 6px; font-size:10px;">Sedang Berjalan</span>
                    <span>Program galang dana</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-12">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Donatur Terlibat</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="fas fa-heart"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value" id="statDonatur">0</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-active" style="padding:1px 6px; font-size:10px;">Orang Baik</span>
                    <span>Telah berkontribusi</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Content: Recent Donations & Campaign Performance -->
<div class="row g-3">
    <div class="col-12">
        <div class="admin-card mb-4">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="admin-card-title">Donasi Masuk Terbaru</h3>
                    <p class="admin-card-desc">5 riwayat transaksi terakhir pada seluruh campaign yayasan Anda</p>
                </div>
                <a href="/Foundation/Donations" class="btn btn-sm btn-outline-secondary btn-tenant-donations" style="font-size:11px;">
                    Lihat Semua <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive p-3">
                <table class="table table-bordered table-hover align-middle w-100" id="tableRecentDonations">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px; text-align: center;">NO</th>
                            <th>DONATUR</th>
                            <th>PROGRAM CAMPAIGN</th>
                            <th>NOMINAL</th>
                            <th>STATUS</th>
                            <th>WAKTU</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="6" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-1"></i> Memuat data...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Performa Program Campaign Yayasan -->
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="admin-card-title">Performa Program Campaign</h3>
                    <p class="admin-card-desc">Tingkat perolehan dana kampanye aktif yayasan Anda</p>
                </div>
                <a href="/Foundation/Campaigns" class="btn btn-sm btn-outline-secondary btn-tenant-campaigns" style="font-size:11px;">
                    Kelola Campaign <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="admin-card-body p-3" id="foundationCampaignsProgressList">
                <div class="text-center py-3" style="color:#94a3b8;">
                    <i class="fas fa-spinner fa-spin me-1"></i> Memuat progres program...
                </div>
            </div>
        </div>
    </div>
</div>

    </div>
</div>

@section Scripts {
<script>
    function loadStats(foundationId) {
        // 1. Ambil Campaigns untuk yayasan ini
        $.ajax({
            url: API_BASE_URL + '/campaigns/foundation/' + foundationId,
            type: 'GET',
            dataType: 'json'
        }).done(function(campaigns) {
            var cList = campaigns || [];
            var activeCount = cList.filter(function(c) { return c.isActive; }).length;
            $('#statCampaign').text(activeCount);

            // Render Performa Program Campaign
            var progressContainer = $('#foundationCampaignsProgressList');
            progressContainer.empty();

            if (cList.length === 0) {
                progressContainer.html('<div class="text-center py-3 text-muted">Belum ada program campaign aktif saat ini.</div>');
            } else {
                cList.slice(0, 4).forEach(function(c) {
                    var target = c.targetAmount || 1;
                    var collected = c.collectedAmount || 0;
                    var pct = Math.min(Math.round((collected / target) * 100), 100);
                    var targetStr = 'Rp ' + target.toLocaleString('id-ID');
                    var collectedStr = 'Rp ' + collected.toLocaleString('id-ID');

                    var pItem = `
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <strong style="font-size:0.8rem; color:#0f172a;">${escHtml(c.title)}</strong>
                                    <span class="status-pill pill-role ms-2" style="font-size:10px;">${escHtml(c.category || 'Program')}</span>
                                </div>
                                <span style="font-size:0.75rem; font-weight:600; color:#0f766e;">${pct}%</span>
                            </div>
                            <div class="progress fnd-dash-progress-track">
                                <div class="progress-bar fnd-dash-progress-fill" style="width:${pct}%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1" style="font-size:11px; color:#64748b;">
                                <span>Terkumpul: <strong style="color:#0f172a;">${collectedStr}</strong></span>
                                <span>Target: ${targetStr}</span>
                            </div>
                        </div>
                    `;
                    progressContainer.append(pItem);
                });
            }

            var campaignIdMap = {};
            cList.forEach(function(c) { campaignIdMap[c.id] = c.title; });
            var campaignIds = cList.map(function(c) { return c.id; });

            // 2. Ambil Donasi Masuk
            $.ajax({
                url: API_BASE_URL + '/donations',
                type: 'GET',
                dataType: 'json'
            }).done(function(allDons) {
                var list = Array.isArray(allDons) ? allDons : (allDons.data || []);
                var foundationDonations = list.filter(function(d) {
                    if (d.campaign && d.campaign.foundation && d.campaign.foundation.id === foundationId) return true;
                    if (campaignIds.indexOf(d.campaignId) !== -1) return true;
                    return false;
                });

                // Tambahkan campaignTitle jika belum ada
                foundationDonations.forEach(function(d) {
                    if (!d.campaignTitle && campaignIdMap[d.campaignId]) {
                        d.campaignTitle = campaignIdMap[d.campaignId];
                    }
                });

                // Hitung Statistik KPI
                var paidDonations = foundationDonations.filter(function(d) {
                    var st = (d.paymentStatus || d.status || '').toLowerCase();
                    return st === 'paid' || st === 'settled' || st === 'success' || st === 'berhasil';
                });
                var totalDonasi = paidDonations.reduce(function(sum, d) { return sum + (d.amount || 0); }, 0);
                var donaturPaid = paidDonations.length;
                var avgDonasi = donaturPaid > 0 ? Math.round(totalDonasi / donaturPaid) : 0;

                $('#statTotalDonasi').text('Rp ' + totalDonasi.toLocaleString('id-ID'));
                $('#statDonatur').text(donaturPaid);
                $('#statAvgDonasi').text('Rp ' + avgDonasi.toLocaleString('id-ID'));

                // Render 5 Donasi Masuk Terbaru
                foundationDonations.sort(function(a, b) {
                    var dateA = new Date(a.paidAt || a.createdAt || a.created_at || 0).getTime();
                    var dateB = new Date(b.paidAt || b.createdAt || b.created_at || 0).getTime();
                    return dateB - dateA || ((b.id || 0) - (a.id || 0));
                });
                var recent = foundationDonations.slice(0, 5);

                if ($.fn.DataTable.isDataTable('#tableRecentDonations')) {
                    $('#tableRecentDonations').DataTable().destroy();
                }

                $('#tableRecentDonations').DataTable({
                    data: recent,
                    paging: false,
                    searching: false,
                    info: false,
                    ordering: false,
                    columns: [
                        {
                            data: null,
                            orderable: false,
                            className: "text-center text-muted",
                            render: function(data, type, row, meta) {
                                return meta.row + 1;
                            }
                        },
                        {
                            data: null,
                            render: function(data, type, row) {
                                var name = row.isAnonymous ? 'Hamba Allah' : (row.donorName || '-');
                                return `<span class="fw-semibold text-dark">${escHtml(name)}</span>`;
                            }
                        },
                        {
                            data: 'campaignTitle',
                            render: function(data) {
                                return `<span style="color:#475569; font-size:12px;">${escHtml(data || '-')}</span>`;
                            }
                        },
                        {
                            data: 'amount',
                            render: function(data) {
                                return `<strong style="color:#0f766e;">Rp ${(data || 0).toLocaleString('id-ID')}</strong>`;
                            }
                        },
                        {
                            data: null,
                            render: function(data, type, row) {
                                var st = (row.paymentStatus || row.status || 'pending').toUpperCase();
                                if (st === 'PAID' || st === 'SETTLED' || st === 'SUCCESS') {
                                    return '<span class="status-pill pill-active"><span class="dot-indicator"></span>Berhasil</span>';
                                } else if (st === 'PENDING') {
                                    return '<span class="status-pill pill-pending"><span class="dot-indicator"></span>Menunggu</span>';
                                } else {
                                    return '<span class="status-pill pill-inactive"><span class="dot-indicator"></span>Gagal</span>';
                                }
                            }
                        },
                        {
                            data: null,
                            render: function(data, type, row) {
                                var rawDate = row.paidAt || row.createdAt || row.created_at;
                                if (!rawDate) return '-';
                                var dt = new Date(rawDate);
                                if (isNaN(dt.getTime())) return '-';
                                var dPart = dt.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                                var tPart = dt.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false }).replace('.', ':');
                                return `<span style="color:#64748b; font-size:11.5px; white-space:nowrap;">${dPart} ${tPart}</span>`;
                            }
                        }
                    ],
                    language: {
                        emptyTable: "Belum ada donasi terbaru."
                    }
                });

            }).fail(function() {
                $('#tableRecentDonations tbody').html('<tr><td colspan="6" class="text-center text-muted py-4">Gagal memuat donasi terbaru.</td></tr>');
            });

        }).fail(function() {
            AdminToast.error('Gagal mengambil data performa yayasan');
            $('#tableRecentDonations tbody').html('<tr><td colspan="5" class="text-center text-muted py-4">Gagal memuat data donasi.</td></tr>');
            $('#foundationCampaignsProgressList').html('<div class="text-center py-3 text-muted">Gagal memuat program campaign.</div>');
        });
    }

    function initFoundationDashboard() {
        var configuredFid = window.CONFIGURED_FOUNDATION_ID || 0;
        if (configuredFid > 0) {
            loadStats(configuredFid);
            return;
        }

        var currentUser = AuthSession.getUser() || {};
        var currentUserId = currentUser.id || currentUser.Id || 0;
        var fId = currentUser.foundationId || currentUser.FoundationId || 0;

        if (fId > 0) {
            loadStats(fId);
            return;
        }

        $.ajax({
            url: API_BASE_URL + '/foundations',
            type: 'GET',
            dataType: 'json',
            success: function(founds) {
                var list = Array.isArray(founds) ? founds : (founds.data || founds.value || []);
                var myFound = (list || []).find(function(f) {
                    if (f.userId === currentUserId || (f.user && f.user.id === currentUserId)) return true;
                    if (Array.isArray(f.foundationUsers) && f.foundationUsers.some(function(fu) { return fu.userId === currentUserId; })) return true;
                    if (Array.isArray(f.userIds) && f.userIds.indexOf(currentUserId) !== -1) return true;
                    return false;
                });
                if (myFound) {
                    loadStats(myFound.id);
                } else if (configuredFid > 0) {
                    loadStats(configuredFid);
                }
            },
            error: function() {
                if (configuredFid > 0) {
                    loadStats(configuredFid);
                }
            }
        });
    }

    $(document).ready(function() {
        $('.btn-tenant-donations, .link-tenant-donations').attr('href', '/Foundation/Donations');
        $('.btn-tenant-campaigns, .link-tenant-campaigns').attr('href', '/Foundation/Campaigns');
        $('.link-tenant-newsposts').attr('href', '/Foundation/NewsPosts');
        $('.link-tenant-settings').attr('href', '/Foundation/Settings');
        initFoundationDashboard();
    });
</script>
}
